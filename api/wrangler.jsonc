{
  // The one backend for kedservice.com and Jacob's iPhone app.
  // Contract: ../docs/mobile-app.md#backend-api-contract-v0
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ked-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ked",
      "database_id": "2affc5fe-4049-4575-abfc-13193c95d52e",
      "migrations_dir": "migrations"
    }
  ],
  // Receipt and job photos. KV, because it's on the free plan with no card:
  // 1 GB and 1,000 uploads a day. Room for years of photos at app upload
  // sizes. To move to R2 later, once Jacob adds his own card to the account:
  // create the bucket, add { "binding": "PHOTOS", "bucket_name": "ked-photos" }
  // under r2_buckets, and new uploads go there. Old ones are still read from KV.
  "kv_namespaces": [{ "binding": "PHOTO_KV", "id": "ffcb3a9165a243488fafa424ec08fd39" }],
  "vars": {
    // Browsers allowed to call the public endpoints. The app is native and
    // doesn't need CORS.
    "ALLOWED_ORIGINS": "https://www.kedservice.com,https://kedservice.com,https://ked-detailing.pages.dev,https://brettboggs.dev,http://localhost:4321",
    // The iPhone app's bundle ID: Apple issues identity tokens for it.
    // Placeholder until the app repo picks its real one.
    "APPLE_AUDIENCE": "com.brettboggs.ked",
    // Who may sign in. Apple `sub` values and/or verified emails, comma-separated.
    // A refused sign-in returns its `sub`, so the first attempt tells you what to add.
    "OWNER_APPLE_SUBS": "",
    "OWNER_EMAILS": "brettmboggs@gmail.com,knockemdowndetailing@gmail.com"
  }
  // Secrets (wrangler secret put), both optional:
  //   ADMIN_TOKEN        break-glass bearer token for Brett's scripts and curl.
  //   PAGES_DEPLOY_HOOK  the ked-detailing Pages deploy hook URL; a pricing save
  //                      POSTs it so the site rebuilds with the new prices.
}
