{
  // The one backend for kedservice.com and Jacob's iPhone app.
  // Contract: ../docs/mobile-app.md#backend-api-contract-v0
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ked-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ked",
      "database_id": "2affc5fe-4049-4575-abfc-13193c95d52e",
      "migrations_dir": "migrations"
    }
  ],
  // Receipt and job photos. KV, because it's on the free plan with no card:
  // 1 GB and 1,000 uploads a day. Room for years of photos at app upload
  // sizes. To move to R2 later, once Jacob adds his own card to the account:
  // create the bucket, add { "binding": "PHOTOS", "bucket_name": "ked-photos" }
  // under r2_buckets, and new uploads go there. Old ones are still read from KV.
  "kv_namespaces": [{ "binding": "PHOTO_KV", "id": "ffcb3a9165a243488fafa424ec08fd39" }],
  // Email from kedservice.com (Cloudflare Email Routing). Free to addresses
  // verified under Email → Destination addresses: Jacob's and Brett's. Customer
  // email needs the Workers Paid plan, so CUSTOMER_EMAIL stays unset.
  "send_email": [{ "name": "EMAIL" }],
  // CRM (docs/crm.md): follow-ups every morning at 9 AM Central (14:00 UTC in
  // summer, 8 AM in winter), and the weekly summary on Monday mornings. The
  // weekly one must match WEEKLY_CRON in src/index.ts.
  "triggers": { "crons": ["0 14 * * *", "0 13 * * 1"] },
  "vars": {
    // Browsers allowed to call the public endpoints. The app is native and
    // doesn't need CORS.
    "ALLOWED_ORIGINS": "https://www.kedservice.com,https://kedservice.com,https://ked-detailing.pages.dev,https://brettboggs.dev,http://localhost:4321",
    // The iPhone app's bundle ID: Apple issues identity tokens for it.
    // Placeholder until the app repo picks its real one.
    "APPLE_AUDIENCE": "com.brettboggs.ked",
    // Who may sign in. Apple `sub` values and/or verified emails, comma-separated.
    // A refused sign-in returns its `sub`, so the first attempt tells you what to add.
    "OWNER_APPLE_SUBS": "001980.46513f188ea7479eb56b73ed3e16f9a1.1958",
    "OWNER_EMAILS": "brettmboggs@gmail.com,knockemdowndetailing@gmail.com,jjsmitty314@yahoo.com",
    // The website's pay page. Invoice links are this plus ?i=<token>. Switch
    // to https://www.kedservice.com/pay/ when the domain moves.
    "PAY_URL": "https://www.kedservice.com/pay/",
    // The customer's page to see, move or cancel a booking: this plus ?b=<token>.
    // Also switches to kedservice.com at cutover.
    "MANAGE_URL": "https://www.kedservice.com/booking/",
    "MAIL_FROM": "alerts@kedservice.com",
    // The web admin. Sign-in links are this plus #login=<token>.
    "ADMIN_URL": "https://www.kedservice.com/admin/",
    // Booking and quote alerts. Comma-separated; each must be a verified destination.
    "ALERT_EMAIL": "knockemdowndetailing@gmail.com",
    // Customer email (confirmations, follow-ups, campaigns) goes out through
    // Resend once RESEND_API_KEY is set; kedservice.com must be verified there.
    // Replies land in Jacob's inbox. The site's address builds unsubscribe links.
    "CUSTOMER_MAIL_FROM": "Jacob at Knock Em' Down <jacob@kedservice.com>",
    "REPLY_TO": "knockemdowndetailing@gmail.com",
    "SITE_URL": "https://www.kedservice.com",
    // This API's own address, for one-click unsubscribe links in emails.
    "API_URL": "https://ked-api.ked-api.workers.dev"
  }
  // Secrets (wrangler secret put), both optional:
  //   ADMIN_TOKEN        break-glass bearer token for Brett's scripts and curl.
  //   PAGES_DEPLOY_HOOK  the ked-detailing Pages deploy hook URL; a pricing save
  //                      POSTs it so the site rebuilds with the new prices.
  //   RESEND_API_KEY     customer email through Resend's free plan (docs/crm.md).
  //   ANTHROPIC_API_KEY  the weekly plain-English insights summary (docs/crm.md).
}
