---
import '../styles/global.css';
import { alsoAvailable, business, faqs, services } from '../data/site';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description: string;
  /** Absolute or site-relative path to the social share image. */
  ogImage?: string;
  /** Emit FAQPage markup. Only true on the page that actually renders the FAQs. */
  includeFaq?: boolean;
  /** Keep this one page out of search, e.g. while it shows placeholder prices. */
  noindex?: boolean;
  /** Send no Referer anywhere, for pages whose URL carries a secret (a pay link). */
  noReferrer?: boolean;
}

const {
  title,
  description,
  ogImage = '/og.jpg',
  includeFaq = false,
  noindex: pageNoindex = false,
  noReferrer = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://www.kedservice.com');

// Anything served from a sub-path is the staging copy on brettboggs.dev. Point
// its canonical at the production URL instead.
const isStaging = (import.meta.env.BASE_URL || '/') !== '/';

// Keep every staging copy out of search so none of them competes with the real
// site. The sub-path build gives itself away through BASE_URL. The Cloudflare
// Pages copy serves from the root of a pages.dev subdomain and cannot, so the
// Pages project sets KED_NOINDEX instead. Remove it there at cutover.
const noindex = pageNoindex || isStaging || process.env.KED_NOINDEX === 'true';
const liveCanonical = isStaging
  ? new URL(Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/',
            'https://www.kedservice.com')
  : canonical;
const ogUrl = new URL(ogImage, Astro.site ?? 'https://www.kedservice.com');

const site = Astro.site ?? 'https://www.kedservice.com';

/**
 * LocalBusiness + FAQPage.
 *
 * aggregateRating is deliberately NOT marked up. Google treats self-hosted
 * ratings for a LocalBusiness as self-serving and disallows them in rich
 * results. The rating is still shown to visitors and linked to its source.
 */
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AutoWash',
      '@id': `${site}#business`,
      name: business.legalName,
      alternateName: business.name,
      slogan: business.motto,
      description:
        'Mobile auto and marine detailing across the greater St. Louis area. Maintenance washes, paint decontamination, one-step machine polishing, interior restoration and paint protection, carried out at your home or workplace.',
      url: site,
      telephone: '+13142232988',
      email: business.email,
      image: ogUrl.href,
      logo: new URL('/apple-touch-icon.png', site).href,
      priceRange: '$$-$$$',
      currenciesAccepted: 'USD',
      sameAs: [business.instagram, business.facebook],
      address: {
        '@type': 'PostalAddress',
        addressLocality: business.baseCity,
        addressRegion: business.region,
        addressCountry: 'US',
      },
      areaServed: [
        { '@type': 'City', name: 'St. Louis' },
        { '@type': 'City', name: 'St. Charles' },
        { '@type': 'City', name: 'High Ridge' },
        { '@type': 'AdministrativeArea', name: 'Jefferson County' },
        { '@type': 'AdministrativeArea', name: 'Greater St. Louis' },
      ],
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: [
            'Monday',
            'Tuesday',
            'Wednesday',
            'Thursday',
            'Friday',
            'Saturday',
            'Sunday',
          ],
          opens: '09:00',
          closes: '17:00',
        },
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Detailing packages',
        itemListElement: [
          ...services.map((s) => ({
            '@type': 'Offer',
            name: `${s.level} — ${s.name}`,
            description: s.summary,
            ...(s.price ? { price: s.price.replace('$', ''), priceCurrency: 'USD' } : {}),
            itemOffered: { '@type': 'Service', name: s.name, serviceType: 'Auto detailing' },
          })),
          ...alsoAvailable.map((a) => ({
            '@type': 'Offer',
            name: a.name,
            description: a.blurb,
            itemOffered: {
              '@type': 'Service',
              name: a.name,
              serviceType: a.name.includes('Marine') ? 'Marine detailing' : 'Auto detailing',
            },
          })),
        ],
      },
      potentialAction: {
        '@type': 'ReserveAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: business.bookingUrl,
          inLanguage: 'en-US',
          actionPlatform: [
            'https://schema.org/DesktopWebPlatform',
            'https://schema.org/MobileWebPlatform',
          ],
        },
      },
    },
    ...(includeFaq
      ? [
          {
            '@type': 'FAQPage',
            '@id': `${site}#faq`,
            mainEntity: faqs.map((f) => ({
              '@type': 'Question',
              name: f.q,
              acceptedAnswer: { '@type': 'Answer', text: f.a },
            })),
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={liveCanonical.href} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {noReferrer && <meta name="referrer" content="no-referrer" />}

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07080a" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogUrl.href} />
    <meta property="og:site_name" content={business.name} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={withBase("/favicon.ico")} sizes="any" />
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=Inter:wght@400;500;600;700&display=swap"
    />

    <!-- set:html is a directive on the element, not a standalone tag. -->
    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />

    <!--
      Reveal-on-scroll starts elements at opacity 0, so if the motion bundle
      never runs — a JS error, a blocked script, an old browser — the page would
      render blank. This is the net: if motion has not reported ready shortly
      after load, everything is forced visible. Inline and dependency-free so it
      cannot fail the same way the bundle can.
    -->
    <script is:inline>
      (function () {
        function reveal() {
          if (window.__kedMotionReady) return;
          var sel = '.rise,[data-stagger-item],[data-hero-fade]';
          document.querySelectorAll(sel).forEach(function (el) {
            el.style.opacity = '1';
            el.style.transform = 'none';
          });
          document.querySelectorAll('[data-hero-line] > span').forEach(function (el) {
            el.style.transform = 'none';
          });
        }
        window.addEventListener('load', function () {
          setTimeout(reveal, 2500);
        });
      })();
    </script>
  </head>

  <body class="antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:bg-gold-500 focus:px-5 focus:py-3 focus:text-ink-950 focus:font-semibold"
    >
      Skip to content
    </a>

    <slot />

    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>
  </body>
</html>
