---
import { band, business } from '../data/site';

/**
 * Type-knockout band.
 *
 * A solid panel in the page colour is painted over the clip with the brand name
 * punched out of it, so the footage only shows inside the letterforms.
 * `textLength` pins each line to the viewBox width, so the lockup fills the band
 * identically whether or not the webfont has landed.
 *
 * On scroll the letters topple like pins — see the script at the foot of the
 * file. The two <text> lines below are the readable, no-JS state; the script
 * replaces them with per-letter copies only once it can measure them exactly.
 */

const LINES = ['KNOCK EM', 'DOWN'];
const BASELINES = [146, 300];
---

<section class="relative overflow-hidden bg-ink-950 py-16 lg:py-24" aria-labelledby="band-heading">
  <h2 id="band-heading" class="sr-only">{business.name}</h2>

  <div class="relative mx-auto max-w-[105rem] px-5 sm:px-8">
    <div class="relative">
      <video
        data-band-video
        data-src={band.video}
        poster={band.poster}
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"
        tabindex="-1"
        class="absolute inset-0 h-full w-full object-cover object-[50%_45%]"
      ></video>

      <!-- The panel: opaque everywhere except the letters. -->
      <svg
        data-knockout
        viewBox="0 0 1000 322"
        class="relative block w-full"
        role="presentation"
        aria-hidden="true"
      >
        <defs>
          <mask id="ked-knockout" data-knockout-mask>
            <rect width="1000" height="322" fill="white" />
            {
              LINES.map((line, i) => (
                <text
                  data-knockout-line={i}
                  x="0"
                  y={BASELINES[i]}
                  textLength="1000"
                  lengthAdjust="spacingAndGlyphs"
                  fill="black"
                  font-family="Archivo, system-ui, sans-serif"
                  font-size="168"
                  font-weight="900"
                  style="font-variation-settings:'wdth' 70,'wght' 900"
                >
                  {line}
                </text>
              ))
            }
          </mask>
        </defs>
        <rect width="1000" height="322" fill="#07080a" mask="url(#ked-knockout)" />
      </svg>
    </div>

    <div
      class="mt-8 flex flex-col gap-5 border-t border-ink-800 pt-7 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="rise max-w-md text-sm leading-relaxed text-bone-400">
        Foam cannon, two-bucket contact wash, decontamination, and a finish you can see your
        reflection in. Every vehicle, every time.
      </p>
      <a
        href={business.bookingUrl}
        target="_blank"
        rel="noopener"
        class="rise inline-flex shrink-0 items-center gap-2 font-display text-[0.78rem] uppercase tracking-[0.18em] text-gold-400 transition-colors hover:text-gold-500"
        style="font-variation-settings:'wdth' 100,'wght' 650"
      >
        Check availability
        <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M1 13L13 1M13 1H4M13 1v9" stroke="currentColor" stroke-width="1.75" />
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const SVG_NS = 'http://www.w3.org/2000/svg';
  const section = document.querySelector<HTMLElement>('#band-heading')?.closest('section');
  const svg = document.querySelector<SVGSVGElement>('[data-knockout]');
  const mask = document.querySelector<SVGElement>('[data-knockout-mask]');
  const video = document.querySelector<HTMLVideoElement>('[data-band-video]');

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* -------------------------------------------------- video ---------------- */

  if (video) {
    const conn = (navigator as any).connection;
    const thrifty = Boolean(conn?.saveData) || /2g/.test(conn?.effectiveType ?? '');

    if (!reduced && !thrifty) {
      // Small, separate clip — only fetched when the band is close to view.
      const io = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            if (!video.src && video.dataset.src) video.src = video.dataset.src;
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        },
        { rootMargin: '200px' },
      );
      io.observe(video);
    }
  }

  /* ----------------------------------------------- the collapse ------------ */

  const CENTRE_X = 500;
  const BASELINES = [146, 300];
  const CAP_HEIGHT = 121; // Archivo caps at 168px, near enough for a pivot.

  type Glyph = { el: SVGTextElement; x: number; line: number; advance: number };

  /**
   * Rebuild each line as one <text> per character, positioned from the laid-out
   * original. Measuring the original matters because `lengthAdjust` stretches
   * the glyphs to fill the band — a naively re-typeset letter would be the
   * wrong width. Each copy carries its own textLength equal to the advance it
   * occupied in the stretched line, which reproduces it exactly.
   */
  function explode(): Glyph[] {
    if (!mask) return [];
    const glyphs: Glyph[] = [];
    const lines = Array.from(mask.querySelectorAll<SVGTextElement>('[data-knockout-line]'));

    lines.forEach((line, lineIndex) => {
      const text = line.textContent ?? '';
      const total = line.getNumberOfChars();

      for (let i = 0; i < total; i++) {
        const ch = text[i];
        if (!ch || ch === ' ') continue;

        const start = line.getStartPositionOfChar(i);
        const advance =
          i < total - 1
            ? line.getStartPositionOfChar(i + 1).x - start.x
            : line.getEndPositionOfChar(i).x - start.x;

        const glyph = document.createElementNS(SVG_NS, 'text') as SVGTextElement;
        glyph.setAttribute('x', String(start.x));
        glyph.setAttribute('y', String(start.y));
        glyph.setAttribute('textLength', String(Math.max(advance, 1)));
        glyph.setAttribute('lengthAdjust', 'spacingAndGlyphs');
        glyph.setAttribute('fill', 'black');
        glyph.setAttribute('font-family', 'Archivo, system-ui, sans-serif');
        glyph.setAttribute('font-size', '168');
        glyph.setAttribute('font-weight', '900');
        glyph.style.fontVariationSettings = "'wdth' 70,'wght' 900";
        glyph.textContent = ch;
        mask.appendChild(glyph);

        glyphs.push({ el: glyph, x: start.x, line: lineIndex, advance });
      }

      line.setAttribute('visibility', 'hidden');
    });

    return glyphs;
  }

  async function init() {
    if (!section || !svg || !mask || reduced) return;

    // getStartPositionOfChar only reports the real layout once the face is in.
    try {
      await (document as any).fonts?.ready;
    } catch {
      /* older browsers just measure with the fallback face */
    }

    let glyphs: Glyph[] = [];
    try {
      glyphs = explode();
    } catch {
      return; // leave the readable two-line version in place
    }
    if (!glyphs.length) return;

    gsap.registerPlugin(ScrollTrigger);

    // Pin so the whole thing plays at viewport centre rather than on the way out.
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: 'center center',
        end: '+=110%',
        scrub: 1.1,
        pin: true,
        pinSpacing: true,
        anticipatePin: 1,
        invalidateOnRefresh: true,
      },
    });

    // Hold upright so the name is read before anything moves.
    tl.to({}, { duration: 0.3 });

    for (const g of glyphs) {
      const centre = g.x + g.advance / 2;
      const offset = centre - CENTRE_X;
      // 0 at the middle of the lockup, 1 at its outer edges.
      const reach = Math.min(Math.abs(offset) / CENTRE_X, 1);

      // Outer letters start first, so the lockup falls inward on itself rather
      // than sweeping across. The windows overlap heavily — it reads as one
      // gesture instead of eleven separate events.
      const at = 0.3 + (1 - reach) * 0.22;

      tl.to(
        g.el,
        {
          // Everything converges on the centre and settles onto the lower line.
          x: -offset * 0.42,
          y: g.line === 0 ? BASELINES[1] - BASELINES[0] - 18 : 8,
          rotation: (offset > 0 ? -1 : 1) * (6 + reach * 22),
          scale: 0.74,
          svgOrigin: `${centre} ${BASELINES[g.line] - CAP_HEIGHT / 2}`,
          ease: 'power2.inOut',
          duration: 0.95,
        },
        at,
      );
    }

    // Let the collapse settle before the section releases.
    tl.to({}, { duration: 0.25 });
  }

  init();
</script>
