---
import { loadSite } from '../lib/live-site';

const { business, testimonials } = await loadSite();
---

<section id="reviews" class="relative overflow-hidden bg-ink-900 py-24 lg:py-32">
  <div class="mx-auto mb-14 max-w-[105rem] px-5 sm:px-8">
    <div class="flex flex-col gap-10 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <div class="rise mb-6 flex items-center gap-4">
          <span class="h-px w-10 bg-gold-500"></span>
          <p class="eyebrow">In their words</p>
        </div>
        <h2 class="display-lg rise max-w-3xl text-bone-50" data-delay="0.08">
          Judged by people<br />{' '}who notice<span class="text-gold-500"> everything.</span>
        </h2>
      </div>

      <!-- Real aggregate rating, linked to the source so it can be checked. -->
      <a
        href={business.reviewsUrl}
        target="_blank"
        rel="noopener"
        class="rise group flex shrink-0 items-center gap-5 border border-ink-800 bg-ink-950 px-6 py-5 transition-colors duration-500 hover:border-gold-600"
        data-delay="0.16"
      >
        <span
          class="font-display text-4xl leading-none text-bone-50"
          style="font-variation-settings:'wdth' 84,'wght' 800"
        >
          {business.rating}
        </span>
        <span>
          <span class="flex gap-0.5 text-gold-500" aria-hidden="true">
            {
              Array.from({ length: 5 }).map(() => (
                <svg width="15" height="15" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M10 0l2.6 6.6L20 7.3l-5.4 4.7 1.7 7L10 15.3 3.7 19l1.7-7L0 7.3l7.4-.7L10 0z" />
                </svg>
              ))
            }
          </span>
          <span class="mt-1.5 block text-xs text-bone-400">
            {business.reviewCount}+ five-star reviews
            <span class="ml-1 inline-block transition-transform duration-300 group-hover:translate-x-0.5"
              >&rarr;</span
            >
          </span>
        </span>
      </a>
    </div>
  </div>

  <div data-marquee data-marquee-speed="70" class="relative overflow-hidden">
    <div data-marquee-track class="flex w-max gap-5 px-5 will-change-transform sm:px-8">
      {
        testimonials.map((t) => (
          <figure class="flex w-[min(86vw,29rem)] shrink-0 flex-col justify-between border border-ink-800 bg-ink-950 p-8 lg:p-9">
            <div>
              <div class="mb-6 flex items-center justify-between gap-4">
                <span class="flex gap-0.5 text-gold-500" aria-label="Five out of five stars">
                  {Array.from({ length: 5 }).map(() => (
                    <svg width="13" height="13" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                      <path d="M10 0l2.6 6.6L20 7.3l-5.4 4.7 1.7 7L10 15.3 3.7 19l1.7-7L0 7.3l7.4-.7L10 0z" />
                    </svg>
                  ))}
                </span>
                <span class="text-[0.68rem] uppercase tracking-[0.16em] text-bone-500">
                  {t.source}
                </span>
              </div>

              <blockquote class="text-[0.98rem] leading-relaxed text-bone-200 lg:text-base">
                {t.quote}
              </blockquote>
            </div>

            <figcaption class="mt-8 flex items-center gap-3 border-t border-ink-800 pt-6">
              <span
                class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-gold-500 font-display text-sm text-ink-950"
                style="font-variation-settings:'wdth' 100,'wght' 700"
                aria-hidden="true"
              >
                {t.name.charAt(0)}
              </span>
              <span>
                <span
                  class="block font-display text-sm uppercase tracking-[0.1em] text-bone-50"
                  style="font-variation-settings:'wdth' 100,'wght' 650"
                >
                  {t.name}
                </span>
                <span class="block text-xs text-bone-500">{t.detail}</span>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="pointer-events-none absolute inset-y-0 left-0 w-16 bg-gradient-to-r from-ink-900 to-transparent sm:w-32"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 w-16 bg-gradient-to-l from-ink-900 to-transparent sm:w-32"></div>
  </div>
</section>
