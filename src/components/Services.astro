---
import { bookLink, serviceIdFor } from '../lib/book';
import { formatMoney, fromPrice } from '@ked/pricing';
import { loadPricing } from '../lib/pricing';
import SitePhoto from './SitePhoto.astro';
import { quoteLive } from '../data/site';
import { loadSite } from '../lib/live-site';
import { withBase } from '../lib/url';

const { alsoAvailable, services } = await loadSite();

// Jacob can rename these, so match loosely to the page that explains them.
const pageFor = (name: string) =>
  /ceramic|coating|correction/i.test(name) ? '/services/ceramic-coating/' : /marine|boat/i.test(name) ? '/services/boat-detailing/' : null;

const numeral = (level: string) => level.replace('Level ', '');

// Once online quotes are live, each package shows its starting price from
// Jacob's saved pricing. Until then, "By quote".
const pricing = quoteLive ? await loadPricing() : null;
const priceText = (level: string) => {
  const id = serviceIdFor(level);
  const from = pricing && id ? fromPrice(pricing, id) : null;
  return from !== null ? `From ${formatMoney(from)}` : 'By quote';
};
---

<section id="services" class="relative overflow-hidden bg-ink-950 py-24 lg:py-36">
  <div class="mx-auto max-w-[105rem] px-5 sm:px-8">
    <div class="mb-14 flex flex-col gap-6 lg:mb-16 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <div class="rise mb-6 flex items-center gap-4">
          <span class="h-px w-10 bg-gold-500"></span>
          <p class="eyebrow">The packages</p>
        </div>
        <h2 class="display-lg rise text-bone-50" data-delay="0.08">
          Four levels.<br /><span class="text-gold-500">One standard.</span>
        </h2>
      </div>
      <p class="rise max-w-sm text-bone-400" data-delay="0.16">
        Every package is fully mobile and finished by hand. Pricing is quoted per vehicle, because
        a garaged coupe and a work truck with three kids in it are not the same job.
      </p>
    </div>

    <!--
      One row is always open. On a fine pointer, moving down the list moves which
      one — it never closes on leave, so the section cannot flicker empty. Click
      and keyboard focus do the same thing for touch and assistive tech.
    -->
    <div data-service-list class="relative border-t border-ink-800">
      {
        services.map((s, i) => (
          <div
            data-service
            data-index={i}
            data-open={i === 0 ? 'true' : 'false'}
            class="group relative border-b border-ink-800"
          >
            {/* Gold rule draws across the top of the active row */}
            <span
              aria-hidden="true"
              class="absolute inset-x-0 -top-px z-10 h-px origin-left scale-x-0 bg-gold-500 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-data-[open=true]:scale-x-100"
            />

            <h3>
              <button
                data-service-toggle
                type="button"
                aria-expanded={i === 0 ? 'true' : 'false'}
                aria-controls={`service-panel-${i}`}
                class="relative flex w-full items-center gap-3 py-6 text-left sm:gap-5 lg:gap-10 lg:py-7"
              >
                <span
                  class="w-7 shrink-0 font-display text-xl text-bone-600 transition-colors duration-500 group-data-[open=true]:text-gold-500 sm:w-9 lg:w-20 lg:text-3xl"
                  style="font-variation-settings:'wdth' 70,'wght' 800"
                >
                  {numeral(s.level)}
                </span>{' '}

                <span class="min-w-0 flex-1">
                  <span
                    class="block font-display uppercase leading-[0.95] text-bone-50 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-data-[open=true]:translate-x-2"
                    style="font-variation-settings:'wdth' 76,'wght' 800; font-size: clamp(1.6rem, 4.6vw, 3.75rem); letter-spacing:-0.02em"
                  >
                    {s.name}
                  </span>{' '}
                  <span class="mt-1.5 block text-xs text-bone-500 lg:hidden">
                    {priceText(s.level)} · {s.duration}
                  </span>
                </span>{' '}

                <span class="hidden shrink-0 text-right lg:block">
                  <span
                    class="block font-display text-xl text-bone-50"
                    style="font-variation-settings:'wdth' 92,'wght' 700"
                  >
                    {priceText(s.level)}
                  </span>{' '}
                  <span class="mt-1 block text-[0.7rem] uppercase tracking-[0.14em] text-bone-500">
                    {s.duration}
                  </span>
                </span>

                <span
                  data-service-icon
                  class="grid h-9 w-9 shrink-0 place-items-center border border-ink-700 text-bone-500 transition-colors duration-500 group-data-[open=true]:border-gold-600 group-data-[open=true]:text-gold-500"
                  aria-hidden="true"
                >
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                    <path d="M6 0v12M0 6h12" stroke="currentColor" stroke-width="1.5" />
                  </svg>
                </span>
              </button>
            </h3>

            <div data-service-panel id={`service-panel-${i}`} class="overflow-hidden">
              <div class="grid gap-8 pb-10 pl-10 sm:pl-14 lg:grid-cols-12 lg:gap-10 lg:pb-12 lg:pl-30">
                <div data-panel-col class="lg:col-span-4">
                  <p class="text-base leading-relaxed text-bone-200 lg:text-lg">{s.summary}</p>
                  <p class="mt-5 border-l-2 border-gold-600 pl-4 text-sm italic leading-relaxed text-bone-400">
                    {s.closer}
                  </p>
                  <a
                    {...bookLink(serviceIdFor(s.level))}
                    class="btn-gold mt-7 !px-6 !py-3.5 !text-[0.72rem]"
                  >
                    Book {s.name}
                    <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                      <path d="M1 13L13 1M13 1H4M13 1v9" stroke="currentColor" stroke-width="1.75" />
                    </svg>
                  </a>
                </div>

                <ul data-panel-col class="space-y-2.5 lg:col-span-3">
                  {s.includes.map((line) => (
                    <li class="flex gap-3 text-sm text-bone-400">
                      <svg
                        width="14"
                        height="14"
                        viewBox="0 0 14 14"
                        fill="none"
                        class="mt-1 shrink-0 text-gold-600"
                        aria-hidden="true"
                      >
                        <path d="M2 7.5L5.5 11L12 3.5" stroke="currentColor" stroke-width="1.75" />
                      </svg>
                      {line}
                    </li>
                  ))}
                </ul>

                {/* Media sits in the layout and wipes open with the panel. */}
                <figure
                  data-panel-media
                  class="relative aspect-[16/10] overflow-hidden bg-ink-850 lg:col-span-5 lg:aspect-auto lg:min-h-[16rem]"
                  style="clip-path: inset(0 0 0 100%)"
                >
                  <SitePhoto
                    src={s.photo}
                    alt={`${s.level} — ${s.name}`}
                    widths={[520, 900, 1200]}
                    sizes="(min-width: 1024px) 40vw, 92vw"
                    loading="eager"
                    class="absolute inset-0 h-full w-full scale-[1.08] object-cover"
                  />
                  <figcaption
                    class="absolute bottom-0 left-0 bg-ink-950/85 px-4 py-2.5 font-display text-[0.65rem] uppercase tracking-[0.2em] text-gold-500 backdrop-blur-sm"
                    style="font-variation-settings:'wdth' 100,'wght' 650"
                  >
                    {s.level}
                  </figcaption>
                </figure>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    {/* Bookable on Housecall Pro but never surfaced on the old site. */}
    {alsoAvailable.length > 0 && <div data-stagger class="mt-16 lg:mt-20">
      <p class="eyebrow rise mb-7">Also available</p>
      <div class="grid gap-px overflow-hidden border border-ink-800 bg-ink-800 md:grid-cols-2">
        {
          alsoAvailable.map((a) => (
            <div data-stagger-item class="translate-y-6 bg-ink-950 p-7 opacity-0 lg:p-8">
              <h3 class="display-sm text-bone-50">{a.name}</h3>
              <p class="mt-3 text-sm leading-relaxed text-bone-400">{a.blurb}</p>
              <a
                {...bookLink()}
                class="mt-6 inline-flex items-center gap-2 font-display text-[0.74rem] uppercase tracking-[0.16em] text-gold-400 transition-colors hover:text-gold-500"
                style="font-variation-settings:'wdth' 100,'wght' 650"
              >
                Enquire
                <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M1 13L13 1M13 1H4M13 1v9" stroke="currentColor" stroke-width="1.75" />
                </svg>
              </a>
              {pageFor(a.name) && (
                <a href={withBase(pageFor(a.name)!)} class="ml-6 text-[0.8rem] text-bone-400 underline underline-offset-4 hover:text-gold-400">
                  How it works
                </a>
              )}
            </div>
          ))
        }
      </div>
    </div>}
  </div>
</section>

<style>
  /* Indent the open panel past the numeral column so it lines up with the name. */
  @media (min-width: 1024px) {
    .lg\:pl-30 {
      padding-left: 7.5rem;
    }
  }
</style>

<script>
  import gsap from 'gsap';

  const list = document.querySelector<HTMLElement>('[data-service-list]');
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-service]'));
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointer = window.matchMedia(
    '(min-width: 1024px) and (hover: hover) and (pointer: fine)',
  );

  let current = 0;

  function setOpen(item: HTMLElement, open: boolean, animate = true) {
    const panel = item.querySelector<HTMLElement>('[data-service-panel]');
    const btn = item.querySelector<HTMLButtonElement>('[data-service-toggle]');
    const icon = item.querySelector<HTMLElement>('[data-service-icon] svg');
    const media = item.querySelector<HTMLElement>('[data-panel-media]');
    const img = media?.querySelector<HTMLElement>('img');
    const cols = item.querySelectorAll<HTMLElement>('[data-panel-col]');
    if (!panel) return;

    item.dataset.open = String(open);
    btn?.setAttribute('aria-expanded', String(open));

    const d = animate && !reduced ? 0.6 : 0;

    gsap.to(panel, { height: open ? 'auto' : 0, duration: d, ease: 'expo.out', overwrite: true });
    if (icon) {
      gsap.to(icon, { rotate: open ? 135 : 0, duration: d, ease: 'expo.out', overwrite: true });
    }

    if (media) {
      // Wipe the media in from the right while the image settles out of its overscale.
      gsap.to(media, {
        clipPath: open ? 'inset(0 0 0 0%)' : 'inset(0 0 0 100%)',
        duration: d * 1.15,
        ease: 'expo.out',
        overwrite: true,
      });
      if (img) {
        gsap.to(img, {
          scale: open ? 1 : 1.08,
          duration: d * 1.6,
          ease: 'expo.out',
          overwrite: true,
        });
      }
    }

    if (cols.length && !reduced) {
      gsap.to(cols, {
        opacity: open ? 1 : 0,
        y: open ? 0 : 14,
        duration: d,
        ease: 'expo.out',
        stagger: open ? 0.06 : 0,
        delay: open ? 0.08 : 0,
        overwrite: true,
      });
    }
  }

  function openRow(index: number, animate = true) {
    if (index === current) return;
    const previous = items[current];
    if (previous) setOpen(previous, false, animate);
    current = index;
    setOpen(items[index], true, animate);
  }

  items.forEach((item, i) => setOpen(item, i === 0, false));

  items.forEach((item, i) => {
    const btn = item.querySelector<HTMLButtonElement>('[data-service-toggle]');

    btn?.addEventListener('click', () => {
      if (finePointer.matches) {
        openRow(i);
      } else if (item.dataset.open === 'true') {
        setOpen(item, false);
        current = -1;
      } else {
        openRow(i);
      }
    });

    // Tabbing to a row should reveal it.
    btn?.addEventListener('focus', () => {
      if (finePointer.matches) openRow(i);
    });

    // A short delay stops the list strobing as the cursor crosses it.
    let hoverTimer: number | undefined;
    item.addEventListener('pointerenter', (e) => {
      if (!finePointer.matches || e.pointerType !== 'mouse') return;
      hoverTimer = window.setTimeout(() => openRow(i), 110);
    });
    item.addEventListener('pointerleave', () => window.clearTimeout(hoverTimer));
  });

  // Panels are sized to 'auto', so a late-decoding image would leave them clipped.
  list?.querySelectorAll('img').forEach((img) => {
    if (img.complete) return;
    img.addEventListener(
      'load',
      () => {
        const panel = items[current]?.querySelector<HTMLElement>('[data-service-panel]');
        if (panel) gsap.set(panel, { height: 'auto' });
      },
      { once: true },
    );
  });
</script>
