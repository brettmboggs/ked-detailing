---
import { loadSite } from '../lib/live-site';

const { faqs } = await loadSite();
---

<section id="faqs" class="relative bg-ink-950 py-24 lg:py-36">
  <div class="mx-auto max-w-[90rem] px-5 sm:px-8">
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <p class="eyebrow rise mb-6">Your questions, answered</p>
        <h2 class="display-lg rise text-bone-50" data-delay="0.08">
          Before<br />{' '}you book.
        </h2>
        <p class="rise mt-7 text-bone-400" data-delay="0.16">
          Anything not covered here, just call. You'll get a straight answer, not a script.
        </p>
      </div>

      <div data-stagger class="lg:col-span-8">
        {
          faqs.map((f, i) => (
            <div
              data-faq
              data-open="false"
              data-stagger-item
              class="translate-y-6 border-b border-ink-800 opacity-0 first:border-t"
            >
              <h3>
                <button
                  data-faq-toggle
                  type="button"
                  aria-expanded="false"
                  aria-controls={`faq-panel-${i}`}
                  class="group flex w-full items-start justify-between gap-6 py-7 text-left"
                >
                  <span class="display-sm max-w-2xl text-bone-50 transition-colors group-hover:text-gold-400">
                    {f.q}
                  </span>
                  <span
                    data-faq-icon
                    class="mt-1 grid h-8 w-8 shrink-0 place-items-center border border-ink-700 text-gold-500 transition-colors group-hover:border-gold-600"
                    aria-hidden="true"
                  >
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                      <path d="M6 0v12M0 6h12" stroke="currentColor" stroke-width="1.5" />
                    </svg>
                  </span>
                </button>
              </h3>

              <div
                data-faq-panel
                id={`faq-panel-${i}`}
                class="h-0 overflow-hidden opacity-0"
              >
                <p class="max-w-2xl pb-8 leading-relaxed text-bone-400">{f.a}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
