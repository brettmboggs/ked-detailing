---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { gallery } from '../data/site';

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.jpg', {
  eager: true,
});
const photoFor = (file: string) => photos[`../assets/photos/${file}`].default;
---

<section class="relative overflow-hidden bg-ink-900 py-24 lg:py-36">
  <div class="mx-auto max-w-[105rem] px-5 sm:px-8">
    <div class="mb-12 flex flex-col gap-6 lg:mb-16 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <div class="rise mb-6 flex items-center gap-4">
          <span class="h-px w-10 bg-gold-500"></span>
          <p class="eyebrow">Ride along with us</p>
        </div>
        <h2 class="display-lg rise text-bone-50" data-delay="0.08">
          Recent<br /><span class="text-gold-500">work.</span>
        </h2>
      </div>
      <p class="rise max-w-sm text-bone-400" data-delay="0.16">
        Shot on the job across the St. Louis metro. Real cars, real driveways. No stock
        photography, no renders.
      </p>
    </div>

    <div
      data-stagger
      class="grid auto-rows-[minmax(0,1fr)] grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4"
    >
      {
        gallery.map((item, i) => (
          <figure
            data-stagger-item
            class:list={[
              'group relative translate-y-8 overflow-hidden bg-ink-850 opacity-0',
              item.span === 'tall' && 'row-span-2 aspect-[3/4] lg:aspect-auto',
              item.span === 'wide' && 'col-span-2 aspect-[4/3] lg:aspect-[16/9]',
              !item.span && 'aspect-square',
            ]}
          >
            <Image
              src={photoFor(item.src)}
              alt={item.alt}
              widths={[420, 840, 1200]}
              sizes="(min-width: 1024px) 26vw, 50vw"
              loading={i < 4 ? 'eager' : 'lazy'}
              data-parallax={item.span === 'tall' ? '10' : '7'}
              class="h-[114%] w-full object-cover transition-[transform,filter] duration-[900ms] ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.05] grayscale-[30%] group-hover:grayscale-0"
            />
            <div class="pointer-events-none absolute inset-0 bg-ink-950/20 transition-opacity duration-700 group-hover:opacity-0" />

            {/* Caption slides up on hover so the grid stays quiet at rest. */}
            <figcaption class="pointer-events-none absolute inset-x-0 bottom-0 translate-y-full bg-gradient-to-t from-ink-950 to-transparent p-4 pt-10 text-[0.7rem] leading-snug text-bone-200 transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-y-0">
              {item.alt}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
