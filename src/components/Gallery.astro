---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { business, gallery } from '../data/site';

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.jpg', {
  eager: true,
});
const photoFor = (file: string) => photos[`../assets/photos/${file}`].default;
---

<section class="relative overflow-hidden bg-ink-900 py-24 lg:py-36">
  <div class="mx-auto max-w-[105rem] px-5 sm:px-8">
    <div class="mb-12 flex flex-col gap-6 lg:mb-16 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <div class="rise mb-6 flex items-center gap-4">
          <span class="h-px w-10 bg-gold-500"></span>
          <p class="eyebrow">Ride along with us</p>
        </div>
        <h2 class="display-lg rise text-bone-50" data-delay="0.08">
          Recent<br /><span class="text-gold-500">work.</span>
        </h2>
      </div>
      <div class="rise max-w-sm" data-delay="0.16">
        <a
          href={business.instagram}
          target="_blank"
          rel="noopener"
          class="group inline-flex items-center gap-2.5 font-display text-[0.76rem] uppercase tracking-[0.16em] text-gold-400 transition-colors hover:text-gold-500"
          style="font-variation-settings:'wdth' 100,'wght' 650"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16zm0 5.68a4.16 4.16 0 100 8.32 4.16 4.16 0 000-8.32zm0 6.86a2.7 2.7 0 110-5.4 2.7 2.7 0 010 5.4zm5.3-7.02a.97.97 0 11-1.94 0 .97.97 0 011.94 0z" />
          </svg>
          The live feed is on Instagram
          <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">&rarr;</span>
        </a>
      </div>
    </div>

    <div
      data-stagger
      class="grid grid-cols-2 gap-3 sm:gap-4 lg:auto-rows-[minmax(0,1fr)] lg:grid-cols-4"
    >
      {
        gallery.map((item, i) => (
          <figure
            data-stagger-item
            class:list={[
              'group relative translate-y-8 overflow-hidden bg-ink-850 opacity-0',
              'aspect-square',
              item.span === 'tall' && 'lg:row-span-2 lg:aspect-auto',
              item.span === 'wide' && 'lg:col-span-2 lg:aspect-[16/9]',
            ]}
          >
            <Image
              src={photoFor(item.src)}
              alt={item.alt}
              widths={[420, 840, 1200]}
              sizes="(min-width: 1024px) 26vw, 50vw"
              loading={i < 4 ? 'eager' : 'lazy'}
              data-parallax={item.span === 'tall' ? '10' : '7'}
              class="h-[114%] w-full object-cover transition-[transform,filter] duration-[900ms] ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.05] grayscale-[30%] group-hover:grayscale-0"
            />
            <div class="pointer-events-none absolute inset-0 bg-ink-950/20 transition-opacity duration-700 group-hover:opacity-0" />

            {/* Caption slides up on hover so the grid stays quiet at rest. */}
            <figcaption class="pointer-events-none absolute inset-x-0 bottom-0 translate-y-full bg-gradient-to-t from-ink-950 to-transparent p-4 pt-10 text-[0.7rem] leading-snug text-bone-200 transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-y-0">
              {item.alt}
            </figcaption>
          </figure>
        ))
      }
    </div>

    <a
      href={business.instagram}
      target="_blank"
      rel="noopener"
      class="rise group mt-5 flex flex-col items-start justify-between gap-5 border border-ink-800 bg-ink-950 p-7 transition-colors duration-500 hover:border-gold-600 sm:flex-row sm:items-center sm:gap-8 lg:p-8"
    >
      <div>
        <p class="display-sm text-bone-50">Every job, as it happens.</p>
        <p class="mt-2 max-w-lg text-sm leading-relaxed text-bone-400">
          New work goes up on {business.instagramHandle} first. Follow along to see what came
          through this week.
        </p>
      </div>
      <span class="btn-gold shrink-0 !px-6 !py-3.5 !text-[0.72rem]">
        Follow along
        <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M1 13L13 1M13 1H4M13 1v9" stroke="currentColor" stroke-width="1.75" />
        </svg>
      </span>
    </a>
  </div>
</section>
