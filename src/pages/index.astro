---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Intro from '../components/Intro.astro';
import BandKnockout from '../components/BandKnockout.astro';
import Services from '../components/Services.astro';
import FollowStrip from '../components/FollowStrip.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Knock Em' Down Detailing | Mobile Auto & Marine Detailing, St. Louis"
  description="Mobile auto and marine detailing across St. Louis. Paint correction, interior restoration and paint protection, done at your home or office. Rated 5.0 across 25+ reviews."
  includeFaq
>
  <Header />

  <main id="main">
    <Hero />
    <!-- Angled gold stripe cutting between the hero and the story. -->
    <Marquee angle={-2.2} variant="gold" speed={58} />
    <Intro />
    <Services />
    {/*
      The lockup sits here deliberately, several screens below the hero.
      Both it and the hero are video, so placing them together made each read
      as the same trick twice and neither landed. Down here it has distance
      from the hero and a job of its own: it breaks a long page and hands off
      into the work.
    */}
    <BandKnockout />
    <FollowStrip />
    <Testimonials />
    <Faq />
    <Cta />
  </main>

  <Footer />
</Base>
