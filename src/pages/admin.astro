---
import Base from '../layouts/Base.astro';
import { business } from '../data/site';
import { withBase } from '../lib/url';

/**
 * The web admin for Jacob and Brett: the whole business from any browser.
 * Grouped into CRM, Schedule, Money, Supplies and Website (see `groups`). The same API the iPhone app uses, so every rule
 * (price validation, booking rules) is enforced in one place.
 *
 * Sign-in is a one-time link emailed to an owner address (OWNER_EMAILS on
 * the Worker). Never indexed, sends no Referer. Everything renders in the
 * browser from src/scripts/admin.ts; the page itself holds no data.
 */
/**
 * Five places, each with its own pages. Twelve tabs in one row scrolled
 * sideways on every screen; grouped, the top row always fits and the second
 * row only shows the pages of the place you're in.
 */
const groups = [
  { id: 'crm', label: 'CRM', tabs: [['today', 'Today'], ['customers', 'Customers'], ['leads', 'Quote requests'], ['marketing', 'Marketing'], ['insights', 'Insights']] },
  { id: 'schedule', label: 'Schedule', tabs: [['bookings', 'Calendar'], ['hours', 'Hours']] },
  { id: 'money', label: 'Money', tabs: [['invoices', 'Invoices'], ['books', 'Books']] },
  { id: 'supplies', label: 'Supplies', tabs: [['inventory', 'Inventory']] },
  { id: 'site', label: 'Website', tabs: [['website', 'Words and photos'], ['prices', 'Prices']] },
];
const groupBtn =
  'whitespace-nowrap border-b-2 border-transparent py-3 font-display text-[0.95rem] uppercase tracking-[0.12em] text-bone-400 transition-colors hover:text-bone-50 ' +
  'aria-[current=true]:border-gold-500 aria-[current=true]:text-bone-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-400';
const tab =
  'whitespace-nowrap py-2.5 text-sm text-bone-400 transition-colors hover:text-bone-50 ' +
  'aria-selected:text-gold-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-400';
---

<Base title="Admin | Knock Em' Down Detailing" description="Knock Em' Down admin." noindex noReferrer>
  <main id="main" class="min-h-svh bg-ink-950 pb-24 text-bone-200">
    <header class="border-b border-ink-800">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-5 py-5 sm:px-8">
        <a href={withBase('/')} class="font-display uppercase text-bone-50" style="font-variation-settings:'wdth' 80,'wght' 800;letter-spacing:-0.01em;font-size:1.35rem">
          Knock Em' Down <span class="text-gold-500">Admin</span>
        </a>
        <div data-who hidden class="flex items-center gap-4 text-sm text-bone-400">
          <span data-who-email></span>
          <button type="button" data-sign-out class="border border-ink-700 px-3 py-1.5 text-bone-200 hover:border-gold-500 hover:text-bone-50">Sign out</button>
        </div>
      </div>
      <nav data-tabs hidden aria-label="Admin sections" class="mx-auto max-w-6xl px-5 sm:px-8">
        <div class="flex flex-wrap gap-x-7 gap-y-1">
          {groups.map((g) => (
            <button type="button" data-group={g.id} data-first={g.tabs[0]![0]} class={groupBtn}>{g.label}</button>
          ))}
        </div>
      </nav>
      <div data-subtabs hidden class="border-t border-ink-800">
        {groups.map((g) => (
          <div role="tablist" aria-label={g.label} data-group-tabs={g.id} hidden={g.tabs.length < 2 || undefined} class="mx-auto flex max-w-6xl flex-wrap gap-x-6 px-5 sm:px-8">
            {g.tabs.map(([id, label]) => (
              <button type="button" role="tab" data-tab={id} class={tab}>{label}</button>
            ))}
          </div>
        ))}
      </div>
    </header>

    <div class="mx-auto max-w-6xl px-5 pt-10 sm:px-8">
      <!-- Signed out: ask for an email, send a link. -->
      <section data-signin hidden class="max-w-md">
        <h1 class="display-lg text-bone-50" style="font-size:clamp(2rem,6vw,3rem)">Sign in</h1>
        <p class="mt-4 text-bone-200">We'll email you a link. It works once, for 15 minutes.</p>
        <form data-signin-form class="mt-8 flex flex-col gap-4" novalidate>
          <label class="flex flex-col gap-1.5 text-sm text-bone-200">
            Email
            <input id="admin-email" name="email" type="email" autocomplete="email" required
              class="w-full rounded-sm border border-ink-700 bg-ink-900 px-4 py-3 text-bone-50 focus:border-gold-500 focus:outline-none" />
          </label>
          <button type="submit" class="btn-gold self-start">Email me a link</button>
        </form>
        <p data-signin-status role="status" hidden class="mt-6 border-l-2 border-gold-500 pl-4 text-bone-200"></p>
      </section>

      <p data-loading class="text-bone-400">Loading…</p>
      <p data-error role="alert" hidden class="mb-6 border-l-2 border-red-400 pl-4 text-red-300"></p>

      <section data-view="today" hidden></section>
      <section data-view="bookings" hidden></section>
      <section data-view="customers" hidden></section>
      <section data-view="leads" hidden></section>
      <section data-view="insights" hidden></section>
      <section data-view="marketing" hidden></section>
      <section data-view="invoices" hidden></section>
      <section data-view="books" hidden></section>
      <section data-view="inventory" hidden></section>
      <section data-view="prices" hidden></section>
      <section data-view="hours" hidden></section>
      <section data-view="website" hidden></section>

      <p class="mt-16 text-xs text-bone-500">Something wrong? Text Brett. {business.name}</p>
    </div>
  </main>
</Base>

<script>
  import { initAdmin } from '../scripts/admin/index';
  initAdmin();
</script>
