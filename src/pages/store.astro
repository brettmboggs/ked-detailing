---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Marquee from '../components/Marquee.astro';
import hoodie from '../assets/photos/ked-hoodie.jpg';
import vanLogo from '../assets/photos/van-logo.jpg';
import { loadSite } from '../lib/live-site';
import { getCollection } from 'astro:content';
import { storeMeta } from '../data/store';
import { withBase } from '../lib/url';

const { business } = await loadSite();

const merch = import.meta.glob<{ default: ImageMetadata }>('../assets/merch/*.{jpg,jpeg,png,webp}', {
  eager: true,
});

/** The CMS may write a full repo path or a bare file name — accept either. */
const merchPhoto = (file?: string) => {
  if (!file) return undefined;
  const name = file.split('/').pop();
  return merch[`../assets/merch/${name}`]?.default;
};

// Published products drive the page state, so nothing has to be toggled by hand.
const products = (await getCollection('products', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name),
);
const isLive = products.length > 0;
---

<Base
  title="Merch | Knock Em' Down Detailing"
  description="Knock Em' Down Detailing merch — hoodies, tees, and caps, printed and shipped on demand."
>
  <Header />

  <main id="main">
    <section class="relative overflow-hidden bg-ink-950 pt-36 pb-16 lg:pt-44 lg:pb-20">
      <div class="mx-auto max-w-[105rem] px-5 sm:px-8">
        <div class="rise mb-6 flex items-center gap-4">
          <span class="h-px w-10 bg-gold-500"></span>
          <p class="eyebrow">{storeMeta.eyebrow}</p>
        </div>

        <h1 class="display-lg max-w-3xl text-bone-50">
          <span class="rise block">{storeMeta.heading[0]}</span>
          <span class="rise block text-gold-500" data-delay="0.08">{storeMeta.heading[1]}</span>
        </h1>

        <p class="rise mt-8 max-w-xl text-lg leading-relaxed text-bone-200" data-delay="0.16">
          {isLive ? storeMeta.blurbLive : storeMeta.blurbPreLaunch}
        </p>
      </div>
    </section>

    <Marquee angle={-1.6} variant="gold" speed={58} />

    {
      isLive ? (
        <section class="bg-ink-950 py-20 lg:py-28">
          <div class="mx-auto max-w-[105rem] px-5 sm:px-8">
            <div data-stagger class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {products.map((entry) => {
                const p = entry.data;
                const img = merchPhoto(p.photo);
                return (
                  <a
                    href={p.href}
                    target="_blank"
                    rel="noopener"
                    data-stagger-item
                    class="group flex translate-y-8 flex-col border border-ink-800 bg-ink-900 opacity-0 transition-colors duration-500 hover:border-ink-700"
                  >
                    <div class="relative aspect-square overflow-hidden bg-ink-850">
                      {img && (
                        <Image
                          src={img}
                          alt={p.name}
                          widths={[420, 840]}
                          sizes="(min-width: 1024px) 30vw, 92vw"
                          class="h-full w-full object-cover transition-transform duration-[900ms] ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.05]"
                        />
                      )}
                      {p.tag && (
                        <span
                          class="absolute left-4 top-4 bg-gold-500 px-2.5 py-1 font-display text-[0.65rem] uppercase tracking-[0.16em] text-ink-950"
                          style="font-variation-settings:'wdth' 100,'wght' 700"
                        >
                          {p.tag}
                        </span>
                      )}
                    </div>

                    <div class="flex flex-1 flex-col p-6">
                      <div class="flex items-start justify-between gap-4">
                        <h2 class="display-sm text-bone-50">{p.name}</h2>
                        <span
                          class="shrink-0 font-display text-lg text-gold-400"
                          style="font-variation-settings:'wdth' 92,'wght' 700"
                        >
                          {p.price}
                        </span>
                      </div>
                      <p class="mt-2.5 text-sm leading-relaxed text-bone-400">{p.blurb}</p>
                      <span
                        class="mt-6 inline-flex items-center gap-2 font-display text-[0.74rem] uppercase tracking-[0.16em] text-bone-50 transition-colors group-hover:text-gold-400"
                        style="font-variation-settings:'wdth' 100,'wght' 650"
                      >
                        Buy
                        <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                          <path d="M1 13L13 1M13 1H4M13 1v9" stroke="currentColor" stroke-width="1.75" />
                        </svg>
                      </span>
                    </div>
                  </a>
                );
              })}
            </div>

            {storeMeta.storefrontUrl && (
              <div class="mt-14 text-center">
                <a href={storeMeta.storefrontUrl} target="_blank" rel="noopener" class="btn-ghost">
                  See the full shop
                </a>
              </div>
            )}
          </div>
        </section>
      ) : (
        <section class="bg-ink-950 py-20 lg:py-28">
          <div class="mx-auto grid max-w-[105rem] gap-12 px-5 sm:px-8 lg:grid-cols-12 lg:gap-16">
            <div class="lg:col-span-6">
              <h2 class="display-sm rise text-bone-50">In the works</h2>
              <p class="rise mt-5 max-w-md leading-relaxed text-bone-400" data-delay="0.08">
                The crew gear you have seen in the van is getting a public run — embroidered
                hoodies, logo tees, and caps. Follow along on Instagram and you will see it the
                day it drops.
              </p>

              <div class="rise mt-9 flex flex-wrap gap-3" data-delay="0.16">
                <a href={business.instagram} target="_blank" rel="noopener" class="btn-gold">
                  Follow {business.instagramHandle}
                </a>
                <a href={withBase("/#services")} class="btn-ghost">Book a detail instead</a>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-4 lg:col-span-6">
              <figure class="rise relative aspect-[4/5] overflow-hidden bg-ink-850">
                <Image
                  src={hoodie}
                  alt="Knock Em Down logo embroidered on a crew hoodie"
                  widths={[400, 800]}
                  sizes="(min-width: 1024px) 24vw, 45vw"
                  class="h-full w-full object-cover"
                />
              </figure>
              <figure class="rise relative aspect-[4/5] overflow-hidden bg-ink-850 lg:mt-10" data-delay="0.1">
                <Image
                  src={vanLogo}
                  alt="The Knock Em Down logo on the side of the work van"
                  widths={[400, 800]}
                  sizes="(min-width: 1024px) 24vw, 45vw"
                  class="h-full w-full object-cover"
                />
              </figure>
            </div>
          </div>
        </section>
      )
    }
  </main>

  <Footer />
</Base>
