---
import { fromPrice, formatMoney } from '@ked/pricing';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { areaPages, servicePages, type AreaPage } from '../../data/local-pages';
import { quoteLive } from '../../data/site';
import { areaFacts } from '../../lib/areas';
import { bookLink, serviceIdFor } from '../../lib/book';
import { loadHours } from '../../lib/hours';
import { loadSite } from '../../lib/live-site';
import { loadPricing } from '../../lib/pricing';
import { withBase } from '../../lib/url';

/**
 * "Mobile detailing in <town>": one page per town Jacob covers most. What
 * makes each one its own (ZIPs, drive time, travel charge, the local note) is
 * in src/data/local-pages.ts and src/lib/areas.ts.
 */
export function getStaticPaths() {
  return areaPages.map((area) => ({ params: { slug: area.slug }, props: { area } }));
}

const { area } = Astro.props as { area: AreaPage };
const { business, services, testimonials } = await loadSite();
const hours = await loadHours();
const pricing = quoteLive ? await loadPricing() : null;
const facts = areaFacts(area, pricing, business.baseCity);
const price = (id: string | undefined) => {
  const from = pricing && id ? fromPrice(pricing, id) : null;
  return from !== null ? `From ${formatMoney(from)}` : 'By quote';
};
const lead = servicePages.find((s) => s.slug === area.lead)!;
const nearby = area.nearby.map((s) => areaPages.find((a) => a.slug === s)).filter((a): a is AreaPage => !!a);
const review = testimonials[0];

const site = Astro.site ?? 'https://www.kedservice.com';
const url = new URL(`/areas/${area.slug}/`, site).href;
const faqs = [
  {
    q: `Do you charge to come to ${area.name}?`,
    a:
      facts.fee === 0
        ? `No. ${area.name} is inside the no-travel-charge area, so the quote is the price.`
        : facts.fee
          ? `${area.name} carries a ${formatMoney(facts.fee)} travel charge, shown in the instant quote before you book.`
          : 'Any travel charge is worked out from your ZIP in the instant quote before you book.',
  },
  {
    q: `When can you come to ${area.name}?`,
    a: `${hours.line}. Pick a time in the instant quote, or text Jacob and he will fit you in.`,
  },
  {
    q: 'What do I need to provide?',
    a: 'Just the car and somewhere to park it. The van brings its own water, power and products, so there is nothing to hook up.',
  },
];
const schema = [
  {
    '@type': 'Service',
    '@id': `${url}#service`,
    name: `Mobile detailing in ${area.name}, ${business.region}`,
    serviceType: 'Mobile auto detailing',
    url,
    provider: { '@id': `${site}#business` },
    areaServed: { '@type': 'City', name: area.name, containedInPlace: { '@type': 'AdministrativeArea', name: area.county } },
  },
  {
    '@type': 'FAQPage',
    '@id': `${url}#faq`,
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site).href },
      { '@type': 'ListItem', position: 2, name: 'Service area', item: new URL('/areas/', site).href },
      { '@type': 'ListItem', position: 3, name: area.name, item: url },
    ],
  },
];
---

<Base
  title={`Mobile Detailing in ${area.name}, ${business.region} | Knock Em' Down`}
  description={`Mobile car and boat detailing in ${area.name}, ${business.region}, ${facts.drive === null ? 'our home base' : facts.driveText.replace(/^About/, 'about')}. ${facts.feeText}. Popular here: ${lead.eyebrow.split(' · ')[0].toLowerCase()}. Instant quote.`}
  schema={schema}
>
  <Header />

  <main id="main" class="bg-ink-950">
    <header class="pt-36 pb-12 lg:pt-44 lg:pb-16">
      <div class="mx-auto max-w-5xl px-5 sm:px-8">
        <div class="mb-6 flex items-center gap-4">
          <span class="h-px w-10 bg-gold-500"></span>
          <p class="eyebrow">
            <a href={withBase('/areas/')} class="hover:text-gold-400">Service area</a> · {area.county}
          </p>
        </div>
        <h1 class="display-lg max-w-4xl text-bone-50">
          <span class="block">Mobile detailing</span>{' '}
          <span class="block text-gold-500">in {area.name}.</span>
        </h1>
        <p class="mt-8 max-w-2xl text-lg leading-relaxed text-bone-200">{area.note}</p>

        <dl class="mt-10 grid gap-x-10 gap-y-4 border-t border-ink-800 pt-6 text-sm sm:grid-cols-3">
          <div><dt class="text-bone-500">Distance</dt><dd class="mt-1 text-bone-50">{facts.driveText}</dd></div>
          <div><dt class="text-bone-500">Travel</dt><dd class="mt-1 text-bone-50">{facts.feeText}</dd></div>
          <div><dt class="text-bone-500">ZIP codes</dt><dd class="mt-1 text-bone-50 tabular-nums">{area.zips.join(', ')}</dd></div>
        </dl>
        <div class="mt-8 flex flex-wrap gap-3">
          <a {...bookLink()} class="btn-gold">Get an instant quote</a>
          <a href={`sms:${business.phoneHref.replace('tel:', '')}`} class="btn-ghost">Text Jacob</a>
        </div>
      </div>
    </header>

    <div class="mx-auto max-w-5xl px-5 pb-20 sm:px-8">
      <section class="border-t border-ink-800 pt-12">
        <h2 class="display-sm text-bone-50">The packages</h2>
        <p class="mt-3 max-w-2xl text-bone-400">
          The same four levels anywhere in the metro, done in your driveway or parking lot. Prices depend on the vehicle and
          its condition; the quote works it out in a minute.
        </p>
        <ul class="mt-8 border-t border-ink-800">
          {
            services.map((s) => (
              <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-ink-800 py-5">
                <div>
                  <p class="text-lg font-semibold text-bone-50">{s.level}: {s.name}</p>
                  <p class="mt-1 max-w-xl text-sm leading-relaxed text-bone-400">{s.summary}</p>
                </div>
                <p class="shrink-0 text-bone-50 tabular-nums">{price(serviceIdFor(s.level))}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="mt-14 border-l-2 border-gold-500 pl-6">
        <p class="eyebrow">Popular in {area.name}</p>
        <h2 class="mt-2 text-2xl font-semibold text-bone-50">
          <a href={withBase(`/services/${lead.slug}/`)} class="hover:text-gold-400">{lead.eyebrow.split(' · ')[0]}</a>
        </h2>
        <p class="mt-3 max-w-2xl leading-relaxed text-bone-200">{lead.description}</p>
        <a href={withBase(`/services/${lead.slug}/`)} class="mt-4 inline-block text-sm text-gold-400 underline underline-offset-4">
          How it works
        </a>
      </section>

      {
        review && (
          <figure class="mt-14">
            <blockquote class="max-w-3xl text-lg leading-relaxed text-bone-50">“{review.quote}”</blockquote>
            <figcaption class="mt-4 text-sm text-bone-400">
              {review.name} · {review.detail} · {review.source}
            </figcaption>
          </figure>
        )
      }

      <section class="mt-16">
        <h2 class="display-sm text-bone-50">Questions from {area.name}</h2>
        <dl class="mt-6 border-t border-ink-800">
          {
            faqs.map((f) => (
              <div class="border-b border-ink-800 py-6">
                <dt class="font-semibold text-bone-50">{f.q}</dt>
                <dd class="mt-2 leading-relaxed text-bone-200">{f.a}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <nav aria-label="Nearby" class="mt-14 grid gap-8 border-t border-ink-800 pt-10 sm:grid-cols-2">
        <div>
          <h2 class="eyebrow mb-4">Nearby</h2>
          <ul class="space-y-2">
            {nearby.map((n) => (
              <li><a href={withBase(`/areas/${n.slug}/`)} class="text-bone-200 underline-offset-4 hover:text-gold-400 hover:underline">Mobile detailing in {n.name}</a></li>
            ))}
            <li><a href={withBase('/areas/')} class="text-bone-200 underline-offset-4 hover:text-gold-400 hover:underline">Everywhere Jacob works</a></li>
          </ul>
        </div>
        <div>
          <h2 class="eyebrow mb-4">Services</h2>
          <ul class="space-y-2">
            {servicePages.map((s) => (
              <li><a href={withBase(`/services/${s.slug}/`)} class="text-bone-200 underline-offset-4 hover:text-gold-400 hover:underline">{s.eyebrow.split(' · ')[0]}</a></li>
            ))}
          </ul>
        </div>
      </nav>
    </div>
  </main>

  <Footer />
</Base>
