---
import Base from '../layouts/Base.astro';
import { business } from '../data/site';
import { withBase } from '../lib/url';

/**
 * Delivery page. Staging only — it is how the finished rebuild is handed over.
 *
 * Deliberately not framed as an approval request. The work is done; what is
 * left is a handful of facts only Jacob can confirm and one action only he can
 * take. Asking him to sign off invites him to redesign it.
 *
 * Deleted at cutover along with the rest of the staging copy; the guard below
 * means it renders as a pointer home if it ever ships to the live domain.
 */
const isStaging = (import.meta.env.BASE_URL || '/') !== '/';

const changes = [
  {
    t: 'Your own footage runs the page',
    d: 'The G-Wagon foam shoot opens the site. None of it was anywhere on the old one.',
  },
  {
    t: 'Your real reviews, with names',
    d: 'Eight five-star Google reviews replace four testimonials nobody wrote. Linked back to the source.',
  },
  {
    t: 'Marine work is finally on there',
    d: 'It is in your registered business name and the old site never mentioned it once.',
  },
  {
    t: 'Ceramic coating and paint correction too',
    d: 'Both are bookable on your Housecall Pro page and neither appeared on the website.',
  },
  {
    t: 'Booking is unchanged',
    d: 'Every button still goes to your Housecall Pro page. Nothing about how you take work changes.',
  },
  {
    t: 'Nothing got lost',
    d: 'Every old web address still works, including the three posts you already show up for in Google.',
  },
];

const decisions = [
  {
    q: 'Happy to show the eight reviews with first names?',
    why: 'They are already public on your Google profile. Say the word and any come off.',
  },
  {
    q: 'Can we say you detail for Porsche St. Louis?',
    why: 'It is the strongest thing on the page. It is stated plainly, so confirm you are comfortable.',
  },
  {
    q: 'Is Level IV above Level III, or its own thing?',
    why: 'The old site said Level III was top tier but listed IV after it. Your booking page treats correction separately.',
  },
  {
    q: 'Any cars on the gold banner you would not claim?',
    why: 'Some are from your photos and reviews, the rest are the kind of work you take. Strike any that are wrong.',
  },
  {
    q: 'Pricing all reads "by quote". Still right?',
    why: 'Nothing on the site commits you to a number.',
  },
  {
    q: 'Got any boat photos?',
    why: 'Marine is mentioned but never shown. One decent photo fixes that.',
  },
];
---

<Base
  title="Knock Em' Down Detailing — rebuilt"
  description="The rebuilt Knock Em' Down Detailing site, and the one thing left before it goes live."
  noindex
>
  {
    !isStaging ? (
      <main id="main" class="grid min-h-[70svh] place-items-center bg-ink-950 px-5">
        <p class="text-bone-400">
          This was a preview page. <a class="text-gold-400 underline" href={withBase('/')}>Go to the site</a>.
        </p>
      </main>
    ) : (
      <main id="main" class="bg-ink-950">
        {/* ---------------------------------------------------------- hero */}
        <section class="relative min-h-[86svh] overflow-hidden grain">
          <video
            data-hero-video
            data-src={withBase('/video/hero-foam.mp4')}
            poster={withBase('/video/hero-foam.jpg')}
            muted
            loop
            playsinline
            preload="none"
            aria-hidden="true"
            tabindex="-1"
            class="absolute inset-0 h-full w-full object-cover object-[50%_42%]"
          />
          <div class="pointer-events-none absolute inset-0 bg-ink-950/55" />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink-950 via-ink-950/40 to-ink-950/50" />

          <div class="relative z-10 mx-auto flex min-h-[86svh] max-w-[105rem] flex-col justify-end px-5 pb-12 pt-28 sm:px-8">
            <p class="eyebrow mb-6">Jacob — it's built</p>
            <h1 class="text-bone-50">
              <span class="launch-hero block">Knock Em Down,</span>
              <span class="launch-hero block text-gold-500">rebuilt.</span>
            </h1>
            <p class="mt-7 max-w-lg text-base leading-relaxed text-bone-200 lg:text-lg">
              Off the Squarespace template and onto something that sells the work — built from your
              own photos and footage. Below is what changed, and the one thing left on your side.
            </p>
            <div class="mt-9 flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
              <a href={withBase('/')} class="btn-gold w-full sm:w-auto">
                Open the site
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M1 13L13 1M13 1H4M13 1v9" stroke="currentColor" stroke-width="1.75" />
                </svg>
              </a>
              <a href="#confirm" class="btn-ghost w-full sm:w-auto">What is left</a>
            </div>
          </div>
        </section>

        {/* ------------------------------------------------------- changes */}
        <section class="py-20 lg:py-28">
          <div class="mx-auto max-w-[105rem] px-5 sm:px-8">
            <div class="rise mb-4 flex items-center gap-4">
              <span class="h-px w-10 bg-gold-500" />
              <p class="eyebrow">What is different</p>
            </div>
            <h2 class="display-lg rise mb-12 max-w-3xl text-bone-50" data-delay="0.06">
              The work was<br /><span class="text-gold-500">already there.</span>
            </h2>

            <ol data-stagger class="grid gap-px overflow-hidden border border-ink-800 bg-ink-800 sm:grid-cols-2">
              {changes.map((c, i) => (
                <li data-stagger-item class="translate-y-6 bg-ink-950 p-7 opacity-0 lg:p-8">
                  <span
                    class="font-display text-sm text-gold-600"
                    style="font-variation-settings:'wdth' 80,'wght' 800"
                  >
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <h3 class="display-sm mt-3 text-bone-50">{c.t}</h3>
                  <p class="mt-2.5 text-sm leading-relaxed text-bone-400">{c.d}</p>
                </li>
              ))}
            </ol>
          </div>
        </section>

        {/* ----------------------------------------------------- decisions */}
        <section id="confirm" class="border-y border-ink-800 bg-ink-900 py-20 lg:py-28">
          <div class="mx-auto max-w-[105rem] px-5 sm:px-8">
            <div class="rise mb-4 flex items-center gap-4">
              <span class="h-px w-10 bg-gold-500" />
              <p class="eyebrow">Six facts to confirm</p>
            </div>
            <h2 class="display-lg rise mb-4 max-w-3xl text-bone-50" data-delay="0.06">
Things I could not<br /><span class="text-gold-500">check myself.</span>
            </h2>
            <p class="rise mb-10 max-w-xl text-bone-400" data-delay="0.12">
              Each one is a claim about your business that only you can verify. Confirm it or
              correct it and the site gets updated. Tick them off as you go — this page remembers
              on your phone.
            </p>

            <ul data-stagger class="space-y-px overflow-hidden border border-ink-800 bg-ink-800">
              {decisions.map((d, i) => (
                <li data-stagger-item class="translate-y-6 bg-ink-950 opacity-0">
                  <label class="flex cursor-pointer items-start gap-4 p-6 lg:p-7">
                    <input
                      type="checkbox"
                      data-check={i}
                      class="peer sr-only"
                      aria-label={d.q}
                    />
                    <span
                      aria-hidden="true"
                      class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center border border-ink-600 text-ink-950 transition-colors peer-checked:border-gold-500 peer-checked:bg-gold-500"
                    >
                      <svg width="13" height="13" viewBox="0 0 14 14" fill="none">
                        <path d="M2 7.5L5.5 11L12 3.5" stroke="currentColor" stroke-width="2" />
                      </svg>
                    </span>
                    <span>
                      <span class="block font-display text-base text-bone-50 peer-checked:text-bone-500 lg:text-lg"
                        style="font-variation-settings:'wdth' 96,'wght' 600">
                        {d.q}
                      </span>
                      <span class="mt-1.5 block text-sm leading-relaxed text-bone-400">{d.why}</span>
                    </span>
                  </label>
                </li>
              ))}
            </ul>
          </div>
        </section>

        {/* ---------------------------------------------------------- next */}
        <section class="py-20 lg:py-28">
          <div class="mx-auto max-w-[105rem] px-5 sm:px-8">
            <div class="rise mb-4 flex items-center gap-4">
              <span class="h-px w-10 bg-gold-500" />
              <p class="eyebrow">When you are happy</p>
            </div>
            <h2 class="display-lg rise max-w-3xl text-bone-50" data-delay="0.06">
              One thing<br /><span class="text-gold-500">left to do.</span>
            </h2>

            <div class="mt-10 grid gap-5 lg:grid-cols-2">
              <div class="rise border border-ink-800 bg-ink-950 p-7 lg:p-8">
                <p class="text-base leading-relaxed text-bone-200">
                  <span class="text-bone-50">kedservice.com</span> is registered on your Squarespace
                  account, so only you can point it at the new site. It takes about five minutes and
                  it is reversible.
                </p>
                <p class="mt-4 text-sm leading-relaxed text-bone-400">
                  Easiest is adding Brett as an administrator on Squarespace and he handles the rest.
                  Otherwise he sends you two settings to paste in.
                </p>
                <p class="mt-4 text-sm leading-relaxed text-bone-400">
                  Your old site keeps running the whole time. Nothing goes dark, and your email is
                  not affected.
                </p>
              </div>

              <div class="rise border border-ink-800 bg-ink-950 p-7 lg:p-8" data-delay="0.1">
                <h3 class="display-sm text-bone-50">Worth ten minutes today</h3>
                <p class="mt-3 text-sm leading-relaxed text-bone-400">
                  Separately from the website — your Google listing currently says
                  <span class="text-bone-200"> closed</span>, lists
                  <span class="text-bone-200"> Chesterfield</span> as your whole service area, and has
                  no boat category. That is turning away calls right now, whatever the site does.
                </p>
                <a
                  href="https://business.google.com/"
                  target="_blank"
                  rel="noopener"
                  class="mt-6 inline-flex items-center gap-2 font-display text-[0.74rem] uppercase tracking-[0.16em] text-gold-400 transition-colors hover:text-gold-500"
                  style="font-variation-settings:'wdth' 100,'wght' 650"
                >
                  Open your Google profile
                  <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M1 13L13 1M13 1H4M13 1v9" stroke="currentColor" stroke-width="1.75" />
                  </svg>
                </a>
              </div>
            </div>

            <div class="rise mt-12 border-t border-ink-800 pt-10">
              <p class="display-sm text-bone-50">Anything factually wrong, send it over.</p>
              <p class="mt-3 max-w-lg text-sm leading-relaxed text-bone-400">
                A service described wrong, a car named wrong, a price that is not right. Those get
                fixed the same day.
              </p>
              <div class="mt-7 flex flex-wrap gap-3">
                <a href={withBase('/')} class="btn-gold">Open the site</a>
                <a
                  href={`mailto:brettmboggs@gmail.com?subject=${encodeURIComponent('Knock Em Down — the new site')}`}
                  class="btn-ghost"
                >
                  Send Brett a note
                </a>
              </div>
              <p class="mt-8 text-xs text-bone-500">
Staged here until the domain moves across. Hidden from search. {business.legalName}.
              </p>
            </div>
          </div>
        </section>
      </main>
    )
  }
</Base>

<style>
  .launch-hero {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 74, 'wght' 850;
    font-size: clamp(3.2rem, 17vw, 11rem);
    line-height: 0.86;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
</style>

<script>
  // Play the hero clip, same rules as the home page.
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (video) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const conn = (navigator as any).connection;
    const thrifty = Boolean(conn?.saveData) || /2g/.test(conn?.effectiveType ?? '');
    if (!reduced && !thrifty) {
      const attach = () => {
        if (!video.dataset.src || video.src) return;
        video.src = video.dataset.src;
        video.play().catch(() => {});
      };
      if (document.readyState === 'complete') attach();
      else window.addEventListener('load', attach, { once: true });
    }
  }

  // Remember the ticked questions on his own device. No account, no backend —
  // he is reading this on a phone and will not do it in one sitting.
  const KEY = 'ked-launch-checks';
  const boxes = document.querySelectorAll<HTMLInputElement>('[data-check]');
  let saved: number[] = [];
  try {
    saved = JSON.parse(localStorage.getItem(KEY) || '[]');
  } catch {
    /* private browsing, or storage disabled — the list still works */
  }
  boxes.forEach((box) => {
    const i = Number(box.dataset.check);
    if (saved.includes(i)) box.checked = true;
    box.addEventListener('change', () => {
      const ticked = Array.from(boxes)
        .filter((b) => b.checked)
        .map((b) => Number(b.dataset.check));
      try {
        localStorage.setItem(KEY, JSON.stringify(ticked));
      } catch {
        /* nothing to do; the page is still usable */
      }
    });
  });
</script>
