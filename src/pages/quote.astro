---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { quoteLive } from '../data/site';
import { loadSite } from '../lib/live-site';
import { withBase } from '../lib/url';
import { formatHours, formatMoney, fromPrice } from '@ked/pricing';
import { apiUrl, loadPricing } from '../lib/pricing';

/**
 * Instant Quote. The formula lives in @ked/pricing and runs in the browser, so
 * a quote costs nothing and works offline once loaded. The iPhone app uses the
 * same package, so a quote here always matches what Jacob sees.
 *
 * The prices are placeholders until Jacob's real numbers are in: the page is
 * noindexed, out of the sitemap and not in the nav, and says so on the page.
 *
 * Styled as a work order, not a component kit: ruled rows, square selectors and
 * segmented controls. No chips, no card grids, no numbered steps.
 */
// Sample prices until the cutover switch in src/data/site.ts goes on.
const { business } = await loadSite();
const PLACEHOLDER_PRICING = !quoteLive;

const config = await loadPricing();
// Handed to the browser script so it prices with exactly what was rendered.
// `<` is escaped so no string in the config can close the script tag.
const configJson = JSON.stringify(config).replace(/</g, '\\u003c');

const vehicleServices = config.services.filter((s) => s.craft === 'vehicle');
const boatServices = config.services.filter((s) => s.craft === 'boat');
const defaultService = 'level-2';
const defaultClass = 'sedan';

const numeral = (level: string) => level.replace('Level ', '');

/** A ruled row. The gold rule on the left marks the chosen one. */
const row =
  'group relative flex cursor-pointer items-center gap-4 border-b border-ink-800 py-4 pl-4 pr-1 transition-colors hover:bg-ink-900/60 ' +
  'before:absolute before:inset-y-0 before:left-0 before:w-0.5 before:origin-top before:scale-y-0 before:bg-gold-500 before:transition-transform before:duration-500 has-[:checked]:before:scale-y-100 ' +
  'has-[:focus-visible]:outline-2 has-[:focus-visible]:-outline-offset-2 has-[:focus-visible]:outline-gold-400';
/** Square selector; filled when its row is chosen. */
const box =
  'grid size-4 shrink-0 place-items-center border border-ink-600 transition-colors group-has-[:checked]:border-gold-500';
const boxFill = 'size-2 scale-0 bg-gold-500 transition-transform group-has-[:checked]:scale-100';
const rowLabel = 'font-semibold text-bone-200 transition-colors group-has-[:checked]:text-bone-50';

/** Joined square segments, like a switch on a spec sheet. */
const segments = 'flex w-full border border-ink-700 sm:w-fit';
const segment =
  'flex flex-1 cursor-pointer items-center justify-center border-l border-ink-700 px-3 py-2.5 text-center text-sm leading-tight text-bone-400 transition-colors first:border-l-0 hover:text-bone-50 sm:flex-none sm:px-4 ' +
  'has-[:checked]:bg-gold-500 has-[:checked]:font-semibold has-[:checked]:text-ink-950 ' +
  'has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-gold-400';

const heading =
  'mb-5 font-display uppercase text-bone-50';
const headingStyle = "font-variation-settings:'wdth' 76,'wght' 800; font-size: clamp(1.35rem, 2.6vw, 1.9rem); letter-spacing:-0.01em";
const fieldLabel = 'flex flex-col gap-1.5 text-sm text-bone-200';
const input =
  'w-full rounded-sm border border-ink-700 bg-ink-900 px-4 py-3 text-bone-50 placeholder:text-bone-600 focus:border-gold-500 focus:outline-none';
---

<Base
  title="Instant Quote | Knock Em' Down Detailing"
  description="Price your detail in under a minute. Pick your vehicle, package and condition and get an instant estimate for mobile detailing across St. Louis."
  noindex={PLACEHOLDER_PRICING}
>
  <Header />

  <main id="main" class="bg-ink-950 pb-32 lg:pb-24">
    <section class="mx-auto max-w-[105rem] px-5 pt-32 pb-10 sm:px-8 lg:pt-40">
      <div class="mb-6 flex items-center gap-4">
        <span class="h-px w-10 bg-gold-500"></span>
        <p class="eyebrow">Instant quote</p>
      </div>
      <h1 class="display-lg max-w-3xl text-bone-50">
        Price it in<br /><span class="text-gold-500">under a minute.</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-bone-200">
        Tell us what you drive and what shape it's in. The estimate updates as you go. Jacob confirms
        the final price when he sees the vehicle.
      </p>
      {
        PLACEHOLDER_PRICING && (
          <p class="mt-6 inline-block border-l-2 border-gold-500 pl-4 text-sm text-gold-400">
            Preview: these are sample prices, not Jacob's real rates yet.
          </p>
        )
      }
    </section>

    <div class="mx-auto grid max-w-[105rem] gap-10 px-5 sm:px-8 lg:grid-cols-[minmax(0,1fr)_24rem] lg:gap-16">
      <form data-quote class="flex flex-col gap-14" novalidate>
        <fieldset>
          <legend class={heading} style={headingStyle}>What are we detailing?</legend>
          <div class={segments} role="radiogroup" aria-label="What are we detailing?">
            <label class={segment}>
              <input type="radio" name="craft" value="vehicle" checked class="sr-only" />
              Car or truck
            </label>
            <label class={segment}>
              <input type="radio" name="craft" value="boat" class="sr-only" />
              Boat
            </label>
          </div>
        </fieldset>

        <fieldset data-craft="vehicle">
          <legend class={heading} style={headingStyle}>Size</legend>
          <div class="border-t border-ink-800">
            {
              config.vehicleClasses.map((c) => (
                <label class={row}>
                  <input
                    type="radio"
                    name="vehicleClass"
                    value={c.id}
                    checked={c.id === defaultClass}
                    class="sr-only"
                  />
                  <span class={box}><span class={boxFill} /></span>
                  <span class="flex min-w-0 flex-1 flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
                    <span class={rowLabel}>{c.label}</span>
                    <span class="text-sm text-bone-500">{c.examples}</span>
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <fieldset data-craft="boat" hidden>
          <legend class={heading} style={headingStyle}>Boat length</legend>
          <label class="flex max-w-xs items-center gap-3">
            <input
              type="number"
              name="boatFeet"
              inputmode="numeric"
              min="1"
              max="100"
              value="20"
              class={input}
              aria-describedby="boat-feet-hint"
            />
            <span class="text-bone-200">feet</span>
          </label>
          <p id="boat-feet-hint" class="mt-2 text-sm text-bone-500">Overall length, bow to stern.</p>
        </fieldset>

        <fieldset>
          <legend class={heading} style={headingStyle}>Package</legend>
          <div class="border-t border-ink-800">
            {
              [...vehicleServices, ...boatServices].map((s) => {
                const from = fromPrice(config, s.id);
                return (
                  <label class={row} data-craft={s.craft} hidden={s.craft !== 'vehicle'}>
                    <input
                      type="radio"
                      name="service"
                      value={s.id}
                      checked={s.id === defaultService}
                      class="sr-only"
                    />
                    <span class={box}><span class={boxFill} /></span>
                    <span
                      class="w-8 shrink-0 font-display text-lg text-bone-600 transition-colors group-has-[:checked]:text-gold-500"
                      style="font-variation-settings:'wdth' 70,'wght' 800"
                      aria-hidden="true"
                    >
                      {s.level ? numeral(s.level) : '+'}
                    </span>
                    <span class={`min-w-0 flex-1 ${rowLabel}`}>{s.name}</span>
                    <span class="shrink-0 text-right text-sm tabular-nums text-bone-400">
                      <span class="block text-bone-200">{from === null ? 'On inspection' : `from ${formatMoney(from)}`}</span>
                      {s.craft === 'vehicle' && <span class="block text-xs text-bone-500">{formatHours(s.hours)}</span>}
                    </span>
                  </label>
                );
              })
            }
          </div>
          <p class="mt-3 text-sm text-bone-500">
            Not sure? <a href={withBase('/#services')} class="text-bone-200 underline decoration-ink-600 underline-offset-4 hover:text-gold-400">See what each level includes</a>.
          </p>
        </fieldset>

        <fieldset>
          <legend class={heading} style={headingStyle}>Condition</legend>
          <p class="-mt-3 mb-5 text-sm text-bone-500">Honest answers get you an honest number.</p>
          <div class="border-t border-ink-800">
            {
              config.conditions.map((c) => (
                <div
                  role="radiogroup"
                  aria-label={c.question}
                  data-condition={c.id}
                  hidden={c.craft !== 'vehicle'}
                  class="flex flex-col gap-3 border-b border-ink-800 py-4 sm:flex-row sm:items-center sm:justify-between sm:gap-8"
                >
                  <p class="text-bone-200">{c.question}</p>
                  <div class={segments}>
                    {c.options.map((o, i) => (
                      <label class={segment}>
                        <input type="radio" name={`cond:${c.id}`} value={o.id} checked={i === 0} class="sr-only" />
                        {o.label}
                      </label>
                    ))}
                  </div>
                </div>
              ))
            }
          </div>
        </fieldset>

        <fieldset data-extras>
          <legend class={heading} style={headingStyle}>Extras</legend>
          <div class="border-t border-ink-800" data-extras-list>
            {
              config.addOns.map((a) => (
                <label class={row} data-addon={a.id} hidden={a.craft !== 'vehicle'}>
                  <input type="checkbox" name="addOns" value={a.id} class="sr-only" />
                  <span class={box}><span class={boxFill} /></span>
                  <span class="flex min-w-0 flex-1 flex-col gap-0.5">
                    <span class={rowLabel}>{a.label}</span>
                    <span class="text-sm text-bone-500">{a.description}</span>
                  </span>
                  <span class="shrink-0 text-sm tabular-nums text-bone-200">
                    +{formatMoney(a.price)}{a.scalesWithSize && a.craft === 'boat' && '/ft'}
                  </span>
                </label>
              ))
            }
          </div>
          <p data-no-extras hidden class="text-sm text-bone-500">
            Everything worth adding is already in this package.
          </p>
        </fieldset>

        <fieldset>
          <legend class={heading} style={headingStyle}>Where</legend>
          <div class="grid gap-4 sm:grid-cols-[10rem_minmax(0,1fr)]">
            <label class="flex flex-col gap-2 text-sm text-bone-200">
              ZIP code
              <input
                type="text"
                name="zip"
                inputmode="numeric"
                autocomplete="postal-code"
                maxlength="5"
                placeholder="63049"
                class={input}
              />
            </label>
            <label class="flex flex-col gap-2 text-sm text-bone-200">
              <span>Year, make and model <span class="text-bone-500">(optional)</span></span>
              <input
                type="text"
                name="vehicle"
                autocomplete="off"
                placeholder="2021 Chevy Tahoe"
                class={input}
              />
            </label>
          </div>
        </fieldset>

        {
          apiUrl && (
            <>
              <fieldset id="when" data-when class="scroll-mt-28">
                <legend class={heading} style={headingStyle}>When</legend>
                <p data-when-status aria-live="polite" class="text-sm text-bone-400">Finding open times…</p>
                <div data-calendar hidden>
                  <div data-days role="radiogroup" aria-label="Day" class="grid grid-cols-7 border-l border-t border-ink-800 text-center" />
                  <div data-times-wrap hidden class="mt-8">
                    <p data-times-label class="mb-3 text-bone-200" />
                    <div data-times role="radiogroup" aria-label="Start time" class="grid grid-cols-3 border-l border-t border-ink-800 text-center sm:grid-cols-4" />
                    <p data-length class="mt-3 text-xs text-bone-500" />
                  </div>
                </div>
              </fieldset>

              <fieldset data-details>
                <legend class={heading} style={headingStyle}>Your details</legend>
                <div class="grid gap-4 sm:grid-cols-2">
                  <label class={fieldLabel}>
                    Name
                    <input name="name" autocomplete="name" maxlength="100" class={input} />
                  </label>
                  <label class={fieldLabel}>
                    Phone
                    <input name="phone" type="tel" autocomplete="tel" maxlength="30" class={input} />
                  </label>
                  <label class={`${fieldLabel} sm:col-span-2`}>
                    <span>Address <span class="text-bone-500">(where the vehicle will be)</span></span>
                    <input name="address" autocomplete="street-address" maxlength="200" class={input} />
                  </label>
                  <label class={fieldLabel}>
                    <span>Email <span class="text-bone-500">(optional)</span></span>
                    <input name="email" type="email" autocomplete="email" maxlength="200" class={input} />
                  </label>
                  <label class={fieldLabel}>
                    <span>Anything Jacob should know? <span class="text-bone-500">(optional)</span></span>
                    <input name="notes" autocomplete="off" maxlength="500" placeholder="Gate code, where to park…" class={input} />
                  </label>
                  <label class={`${fieldLabel} sm:col-span-2`}>
                    <span>How did you hear about us? <span class="text-bone-500">(optional)</span></span>
                    <select name="source" class={input}>
                      <option value="">Pick one</option>
                      <option value="google">Google search</option>
                      <option value="maps">Google Maps</option>
                      <option value="instagram">Instagram</option>
                      <option value="facebook">Facebook</option>
                      <option value="nextdoor">Nextdoor</option>
                      <option value="referral">A friend or family member</option>
                      <option value="van">Saw the van</option>
                      <option value="repeat">I've used Jacob before</option>
                      <option value="other">Somewhere else</option>
                    </select>
                  </label>
                  {/* Honeypot. Hidden from people and screen readers; bots fill it in. */}
                  <label class="hidden" aria-hidden="true">
                    Website <input name="website" tabindex="-1" autocomplete="off" />
                  </label>
                </div>

                <p data-submit-error role="alert" hidden class="mt-5 border-l-2 border-red-400 pl-3 text-sm text-red-300" />

                <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center">
                  <button type="submit" data-book disabled class="btn-gold disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:translate-y-0 disabled:hover:shadow-none">
                    Pick a time above
                  </button>
                  <button type="button" data-send-lead class="btn-ghost">Just send the quote</button>
                </div>
                <p class="mt-4 text-xs leading-relaxed text-bone-500">
                  Nothing is charged to book. Jacob confirms the final price when he sees the vehicle.
                </p>
              </fieldset>

              <div data-done hidden tabindex="-1" class="border-l-2 border-gold-500 pl-5 focus:outline-none">
                <p data-done-title class="font-display uppercase text-bone-50" style={headingStyle} />
                <p data-done-body class="mt-2 max-w-xl text-bone-200" />
                <a data-done-link hidden class="btn-ghost mt-5">Your booking</a>
              </div>
            </>
          )
        }
      </form>

      <!-- Summary. Sticky beside the form on desktop, after it on phones. -->
      <aside id="summary" class="lg:sticky lg:top-28 lg:self-start">
        <!-- Capped to the viewport on desktop so the send button is never pinned out of reach. -->
        <div class="rounded-sm border border-ink-700 bg-ink-900 p-6 edge-light lg:max-h-[calc(100dvh-8rem)] lg:overflow-y-auto lg:overscroll-contain [scrollbar-width:thin] [scrollbar-color:var(--color-ink-700)_transparent]">
          <p class="eyebrow mb-3">Your estimate</p>
          <p data-range aria-live="polite" class="font-display text-bone-50" style="font-size:clamp(2.2rem,4vw,3rem);font-variation-settings:'wdth' 80,'wght' 800">
            —
          </p>
          <p data-hours class="mt-1 text-sm text-bone-400"></p>

          <ul data-lines class="mt-6 flex flex-col gap-2 border-t border-ink-800 pt-5 text-sm"></ul>
          <ul data-notes class="mt-4 flex flex-col gap-1.5 text-sm text-gold-400"></ul>

          <p class="mt-5 text-xs leading-relaxed text-bone-500">
            An estimate, not a bill. Jacob confirms the final price when he sees the vehicle, and
            nothing is charged until the work is agreed.
          </p>

          {
            apiUrl && (
              <p data-chosen hidden class="mt-5 border-t border-ink-800 pt-5 text-sm">
                <span class="block text-xs uppercase tracking-[0.2em] text-bone-500">Your time</span>
                <span data-chosen-text class="mt-1 block font-semibold text-bone-50" />
              </p>
            )
          }

          <div class="mt-6 flex flex-col gap-3">
            <a data-sms href={business.phoneHref} class={apiUrl ? 'btn-ghost w-full' : 'btn-gold w-full'}>
              {apiUrl ? 'Or text Jacob' : 'Text Jacob this quote'}
            </a>
            {/* Housecall Pro only when our own calendar isn't connected. */}
            {
              !apiUrl && (
                <a href={business.bookingUrl} target="_blank" rel="noopener" class="text-center text-sm text-bone-400 hover:text-gold-400">
                  Book online
                </a>
              )
            }
            <a href={business.phoneHref} class="text-center text-sm text-bone-400 hover:text-gold-400">
              Or call {business.phone}
            </a>
          </div>
        </div>
      </aside>
    </div>

    <!-- Phones: the running total stays in reach while scrolling the form. -->
    <a
      href={apiUrl ? '#when' : '#summary'}
      data-mobile-bar
      class="fixed inset-x-0 bottom-0 z-40 flex items-center justify-between gap-4 border-t border-ink-700 bg-ink-950/95 px-5 py-4 backdrop-blur-xl lg:hidden"
    >
      <span>
        <span class="block text-xs uppercase tracking-[0.2em] text-bone-500">Estimate</span>
        <span data-bar-range class="font-display text-xl text-bone-50" style="font-variation-settings:'wdth' 80,'wght' 800">—</span>
      </span>
      <span class="btn-gold !px-5 !py-3">{apiUrl ? 'Pick a time' : 'Next steps'}</span>
    </a>
  </main>

  <Footer />
  <script type="application/json" id="ked-pricing" set:html={configJson} />
</Base>

<script>
  import {
    applicableAddOns,
    applicableConditions,
    formatHours,
    formatMoney,
    formatRange,
    quote,
    QuoteError,
    type Craft,
    type PricingConfig,
    type QuoteInput,
  } from '@ked/pricing';
  import { initBooking } from '../scripts/booking';

  const PHONE = '+13142232988';
  const API = import.meta.env.PUBLIC_KED_API_URL?.replace(/\/$/, '');
  const config = JSON.parse(document.getElementById('ked-pricing')!.textContent!) as PricingConfig;

  const form = document.querySelector<HTMLFormElement>('[data-quote]')!;
  const $ = <T extends Element>(sel: string) => document.querySelector<T>(sel)!;
  const rangeEl = $<HTMLElement>('[data-range]');
  const barRangeEl = $<HTMLElement>('[data-bar-range]');
  const hoursEl = $<HTMLElement>('[data-hours]');
  const linesEl = $<HTMLUListElement>('[data-lines]');
  const notesEl = $<HTMLUListElement>('[data-notes]');
  const smsEl = $<HTMLAnchorElement>('[data-sms]');

  const radio = (name: string) =>
    form.querySelector<HTMLInputElement>(`input[name="${CSS.escape(name)}"]:checked`)?.value;

  /** Keep the chosen service on the chosen craft; fall back to its first one. */
  function syncCraft(craft: Craft) {
    for (const el of form.querySelectorAll<HTMLElement>('[data-craft]')) {
      el.hidden = el.dataset.craft !== craft;
    }
    const current = config.services.find((s) => s.id === radio('service'));
    if (current?.craft !== craft) {
      const first = config.services.find((s) => s.craft === craft);
      const input = form.querySelector<HTMLInputElement>(`input[name="service"][value="${first?.id}"]`);
      if (input) input.checked = true;
    }
  }

  /** Show only the questions and extras that change the price of this service. */
  function syncService(serviceId: string) {
    const service = config.services.find((s) => s.id === serviceId);
    if (!service) return;
    const conditions = new Set(applicableConditions(config, service).map((c) => c.id));
    for (const el of form.querySelectorAll<HTMLElement>('[data-condition]')) {
      el.hidden = !conditions.has(el.dataset.condition!);
    }
    const addOns = new Set(applicableAddOns(config, service).map((a) => a.id));
    for (const el of form.querySelectorAll<HTMLElement>('[data-addon]')) {
      el.hidden = !addOns.has(el.dataset.addon!);
    }
    $<HTMLElement>('[data-no-extras]').hidden = addOns.size > 0;
    $<HTMLElement>('[data-extras-list]').hidden = addOns.size === 0;
  }

  function readInput(): QuoteInput {
    const data = new FormData(form);
    const conditions: Record<string, string> = {};
    for (const [key, value] of data) {
      if (key.startsWith('cond:')) conditions[key.slice(5)] = String(value);
    }
    const feet = Number(data.get('boatFeet'));
    return {
      service: radio('service') ?? '',
      vehicleClass: radio('vehicleClass'),
      boatFeet: Number.isFinite(feet) && feet > 0 ? feet : undefined,
      conditions,
      addOns: data.getAll('addOns').map(String),
      zip: String(data.get('zip') ?? ''),
    };
  }

  function li(text: string, amount?: string) {
    const el = document.createElement('li');
    el.className = 'flex justify-between gap-4';
    const label = document.createElement('span');
    label.textContent = text;
    el.append(label);
    if (amount) {
      const value = document.createElement('span');
      value.className = 'shrink-0 text-bone-200 tabular-nums';
      value.textContent = amount;
      el.append(value);
    }
    return el;
  }

  function render() {
    const craft = (radio('craft') ?? 'vehicle') as Craft;
    syncCraft(craft);
    syncService(radio('service') ?? '');

    const input = readInput();
    let q;
    try {
      q = quote(config, input);
    } catch (err) {
      if (!(err instanceof QuoteError)) throw err;
      rangeEl.textContent = barRangeEl.textContent = '—';
      hoursEl.textContent = craft === 'boat' ? "Enter the boat's length to price it." : '';
      linesEl.replaceChildren();
      notesEl.replaceChildren();
      booking?.changed(null);
      return;
    }

    const price = q.range ? formatRange(q.range) : 'By inspection';
    rangeEl.textContent = barRangeEl.textContent = price;
    hoursEl.textContent = `About ${formatHours(q.hours)} of work`;
    linesEl.replaceChildren(
      ...q.lines.map((l) => li(l.label, q.range ? formatMoney(l.amount) : undefined)),
    );
    notesEl.replaceChildren(...q.notes.map((n) => li(n)));

    // Everything Jacob needs to reply with a firm number, in one text.
    const vehicle = String(new FormData(form).get('vehicle') ?? '').trim();
    const body = [
      'Hi Jacob, I priced a detail on your website:',
      ...q.lines.map((l) => `• ${l.label}`),
      vehicle && `Vehicle: ${vehicle}`,
      input.zip && `ZIP: ${input.zip}`,
      `Estimate: ${price}`,
    ]
      .filter(Boolean)
      .join('\n');
    // `?&body=` is the form both iOS and Android Messages accept.
    smsEl.href = `sms:${PHONE}?&body=${encodeURIComponent(body)}`;
    booking?.changed(q);
  }

  // Calendar, details and submit live in their own module; it only runs when
  // the API is configured, because the markup it drives only exists then.
  const booking = API ? initBooking({ api: API, form, readInput, phone: PHONE }) : null;

  // A package's "Book" button links here with ?service=level-2: start on it.
  const wanted = new URLSearchParams(location.search).get('service');
  const pick = wanted && form.querySelector<HTMLInputElement>(`input[name="service"][value="${CSS.escape(wanted)}"]`);
  if (pick) pick.checked = true;

  form.addEventListener('input', render);
  form.addEventListener('change', render);
  // Back/forward cache can restore a filled form; price what is actually shown.
  window.addEventListener('pageshow', render);
  render();
</script>
