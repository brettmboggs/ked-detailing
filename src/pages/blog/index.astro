---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Marquee from '../../components/Marquee.astro';
import { business } from '../../data/site';

const heroes = import.meta.glob<{ default: ImageMetadata }>('../../assets/blog/*.{jpg,jpeg,png,webp}', {
  eager: true,
});
const heroFor = (file?: string) =>
  file ? heroes[`../../assets/blog/${file.split('/').pop()}`]?.default : undefined;

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base
  title="Detailing Notes | Knock Em' Down Detailing"
  description="Practical car care notes from a St. Louis mobile detailer — how often to detail, what professional detailing actually does, and why it pays for itself."
>
  <Header />

  <main id="main">
    <section class="relative overflow-hidden bg-ink-950 pt-36 pb-14 lg:pt-44 lg:pb-16">
      <div class="mx-auto max-w-[105rem] px-5 sm:px-8">
        <div class="rise mb-6 flex items-center gap-4">
          <span class="h-px w-10 bg-gold-500"></span>
          <p class="eyebrow">Notes</p>
        </div>
        <h1 class="display-lg max-w-3xl text-bone-50">
          <span class="rise block">Car care,</span>
          <span class="rise block text-gold-500" data-delay="0.08">straight up.</span>
        </h1>
        <p class="rise mt-8 max-w-xl text-lg leading-relaxed text-bone-200" data-delay="0.16">
          What we have learned keeping St. Louis cars clean through salted winters and humid
          summers.
        </p>
      </div>
    </section>

    <Marquee angle={-1.6} variant="gold" speed={44} />

    <section class="bg-ink-950 py-20 lg:py-28">
      <div class="mx-auto max-w-[105rem] px-5 sm:px-8">
        <div data-stagger class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {
            posts.map((post) => {
              const img = heroFor(post.data.hero);
              return (
                <a
                  href={`/blog/${post.id}`}
                  data-stagger-item
                  class="group flex translate-y-8 flex-col border border-ink-800 bg-ink-900 opacity-0 transition-colors duration-500 hover:border-gold-600"
                >
                  {img && (
                    <div class="relative aspect-[16/10] overflow-hidden bg-ink-850">
                      <Image
                        src={img}
                        alt={post.data.heroAlt}
                        widths={[420, 840]}
                        sizes="(min-width: 1024px) 30vw, 92vw"
                        class="h-full w-full object-cover transition-transform duration-[900ms] ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.04]"
                      />
                    </div>
                  )}
                  <div class="flex flex-1 flex-col p-6 lg:p-7">
                    <time
                      datetime={post.data.pubDate.toISOString()}
                      class="text-[0.7rem] uppercase tracking-[0.16em] text-bone-500"
                    >
                      {fmt(post.data.pubDate)}
                    </time>
                    <h2 class="display-sm mt-3 text-bone-50 transition-colors group-hover:text-gold-400">
                      {post.data.title}
                    </h2>
                    <p class="mt-3 flex-1 text-sm leading-relaxed text-bone-400">
                      {post.data.description}
                    </p>
                    <span
                      class="mt-6 inline-flex items-center gap-2 font-display text-[0.72rem] uppercase tracking-[0.16em] text-bone-50 transition-colors group-hover:text-gold-400"
                      style="font-variation-settings:'wdth' 100,'wght' 650"
                    >
                      Read it
                      <span class="transition-transform duration-300 group-hover:translate-x-1">&rarr;</span>
                    </span>
                  </div>
                </a>
              );
            })
          }
        </div>

        <div class="rise mt-14 border-t border-ink-800 pt-10 text-center">
          <p class="text-bone-400">Rather just get it booked?</p>
          <a
            href={business.bookingUrl}
            target="_blank"
            rel="noopener"
            class="btn-gold mt-5"
          >
            Book your detail
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
