---
import { bookLink } from '../../lib/book';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { loadSite } from '../../lib/live-site';
import { withBase } from '../../lib/url';

const { business } = await loadSite();

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const heroes = import.meta.glob<{ default: ImageMetadata }>('../../assets/blog/*.{jpg,jpeg,png,webp}', {
  eager: true,
});
const hero = post.data.hero
  ? heroes[`../../assets/blog/${post.data.hero.split('/').pop()}`]?.default
  : undefined;

const site = Astro.site ?? 'https://www.kedservice.com';
const url = new URL(`/blog/${post.id}/`, site).href;

// BlogPosting and a breadcrumb trail, so posts can show as articles in search
// rather than as more pages of the business.
const schema = [
  {
    '@type': 'BlogPosting',
    '@id': `${url}#post`,
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    mainEntityOfPage: url,
    ...(hero ? { image: new URL(hero.src, site).href } : {}),
    ...(post.data.tags.length ? { keywords: post.data.tags.join(', ') } : {}),
    author: { '@id': `${site}#business` },
    publisher: { '@id': `${site}#business` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site).href },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', site).href },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
    ],
  },
];

// Google cuts titles off at around 60 characters. Long post titles go out bare
// so the words that rank are the ones that show.
const fullTitle = `${post.data.title} | Knock Em' Down Detailing`;
const title = fullTitle.length > 60 ? post.data.title : fullTitle;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base
  title={title}
  description={post.data.description}
  ogType="article"
  ogImage={hero?.src}
  schema={schema}
>
  <Header />

  <main id="main">
    <article>
      <header class="relative overflow-hidden bg-ink-950 pt-36 pb-12 lg:pt-44 lg:pb-14">
        <div class="mx-auto max-w-3xl px-5 sm:px-8">
          <a
            href={withBase("/blog")}
            class="group inline-flex items-center gap-2 font-display text-[0.72rem] uppercase tracking-[0.16em] text-bone-500 transition-colors hover:text-gold-400"
            style="font-variation-settings:'wdth' 100,'wght' 650"
          >
            <span class="transition-transform duration-300 group-hover:-translate-x-1">&larr;</span>
            All notes
          </a>

          <h1
            class="mt-7 font-display uppercase leading-[0.95] text-bone-50"
            style="font-variation-settings:'wdth' 80,'wght' 800; font-size: clamp(2rem, 5.4vw, 3.75rem); letter-spacing:-0.02em"
          >
            {post.data.title}
          </h1>

          <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-ink-800 pt-5">
            <time
              datetime={post.data.pubDate.toISOString()}
              class="text-[0.7rem] uppercase tracking-[0.16em] text-gold-500"
            >
              {fmt(post.data.pubDate)}
            </time>
            <span class="text-[0.7rem] uppercase tracking-[0.16em] text-bone-500">
              {business.name}
            </span>
          </div>
        </div>
      </header>

      {
        hero && (
          <div class="mx-auto max-w-5xl px-5 sm:px-8">
            <figure class="relative aspect-[16/9] overflow-hidden bg-ink-850">
              <Image
                src={hero}
                alt={post.data.heroAlt}
                widths={[800, 1200, 1600]}
                sizes="(min-width: 1024px) 64rem, 92vw"
                loading="eager"
                class="h-full w-full object-cover"
              />
            </figure>
          </div>
        )
      }

      <div class="mx-auto max-w-3xl px-5 py-16 sm:px-8 lg:py-20">
        <div class="prose-ked">
          <Content />
        </div>

        {
          post.data.tags.length > 0 && (
            <ul class="mt-14 flex flex-wrap gap-2 border-t border-ink-800 pt-8">
              {post.data.tags.map((tag) => (
                <li class="border border-ink-800 px-3 py-1.5 text-[0.68rem] uppercase tracking-[0.14em] text-bone-500">
                  {tag}
                </li>
              ))}
            </ul>
          )
        }

        <aside class="mt-12 border border-ink-800 bg-ink-900 p-8 lg:p-10">
          <h2 class="display-sm text-bone-50">Want it done properly?</h2>
          <p class="mt-3 max-w-lg text-sm leading-relaxed text-bone-400">
            Fully mobile across the St. Louis metro. We bring the water, the power and the
            products to your driveway.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a {...bookLink()} class="btn-gold">
              Book your detail
            </a>
            <a href={business.phoneHref} class="btn-ghost">{business.phone}</a>
          </div>
        </aside>
      </div>
    </article>
  </main>

  <Footer />
</Base>
